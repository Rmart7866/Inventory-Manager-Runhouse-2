{
  "manifest_version": 3,
  "name": "Run House Order Prep",
  "version": "1.2.2",
  "description": "Sets up a supplier order (items, ship-to address, PO) for a dropship order from the Late orders page, on HOKA, ON and Brooks. Never submits an order.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://hokaus.deckersb2b.deckers.com/*",
    "https://backstage.on-running.com/*",
    "https://fasttrack.brooksrunning.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rmart7866.github.io/Inventory-Manager-Runhouse-2/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": [
        "staff.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://hokaus.deckersb2b.deckers.com/*"
      ],
      "js": [
        "xlsx.js",
        "hoka.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://backstage.on-running.com/*"
      ],
      "js": [
        "common.js",
        "on.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fasttrack.brooksrunning.com/*"
      ],
      "js": [
        "common.js",
        "brooks.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
