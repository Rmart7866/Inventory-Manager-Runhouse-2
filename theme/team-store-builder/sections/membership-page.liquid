<section class="trh-mb" id="Membership-{{ section.id }}">

  {%- if section.settings.banner_image != blank -%}
    <div class="trh-mb__banner trh-mb__banner--{{ section.settings.banner_height }}" style="--trh-overlay: {{ section.settings.banner_overlay | divided_by: 100.0 }};">
      <img
        src="{{ section.settings.banner_image | image_url: width: 2400 }}"
        srcset="{{ section.settings.banner_image | image_url: width: 800 }} 800w, {{ section.settings.banner_image | image_url: width: 1400 }} 1400w, {{ section.settings.banner_image | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt="{{ section.settings.title | escape }}"
        class="trh-mb__banner-img"
        width="2400" height="900" loading="eager">
      <div class="trh-mb__banner-inner">
        {%- if section.settings.kicker != blank -%}
          <p class="trh-mb__kicker trh-mb__kicker--banner">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h1 class="trh-mb__title trh-mb__title--banner">{{ section.settings.title }}</h1>
        {%- if section.settings.intro != blank -%}
          <p class="trh-mb__intro trh-mb__intro--banner">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="trh-mb__container">

    {%- if section.settings.banner_image == blank -%}
      <div class="trh-mb__head">
        {%- if section.settings.kicker != blank -%}
          <p class="trh-mb__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h1 class="trh-mb__title">{{ section.settings.title }}</h1>
        {%- if section.settings.intro != blank -%}
          <p class="trh-mb__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- unless customer -%}
      <p class="trh-mb__signin-note">
        <svg width="15" height="15" viewBox="0 0 14 14" aria-hidden="true"><path d="M7 1a3 3 0 0 1 3 3v2H4V4a3 3 0 0 1 3-3z" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="2.5" y="6" width="9" height="6.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
        <span>Member pricing and free US shipping apply when you are signed in to your account. Be sure to log in before checkout, guest checkout will not apply your benefits even with your membership email.</span>
      </p>
    {%- endunless -%}

    <div class="trh-mb__grid trh-mb__grid--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tier_product = block.settings.product
          assign is_current = false
          if customer and block.settings.tier_tag != blank and customer.tags contains block.settings.tier_tag
            assign is_current = true
          endif

          assign tier_name = block.settings.name
          if tier_name == blank and tier_product != blank
            assign tier_name = tier_product.title
          endif

          comment
            Subscription price: pull the selling plan allocation off the
            first variant. tier_sub_price is the discounted annual price,
            tier_sub_compare is the regular price to strike through.
          endcomment
          assign tier_sub_price = blank
          assign tier_sub_compare = blank
          assign tier_pv = tier_product.selected_or_first_available_variant
          if tier_pv and tier_pv.selling_plan_allocations.size > 0
            assign tier_alloc = tier_pv.selling_plan_allocations | first
            assign tier_sub_price = tier_alloc.price
            assign tier_sub_compare = tier_alloc.compare_at_price | default: tier_pv.price
          endif

          assign tier_image = block.settings.image | default: tier_product.featured_image
        -%}

        <div class="trh-mb__card{% if block.settings.badge != blank %} trh-mb__card--featured{% endif %}{% if is_current %} trh-mb__card--current{% endif %}" {{ block.shopify_attributes }}>

          {%- if is_current -%}
            <span class="trh-mb__badge trh-mb__badge--current">
              <svg width="12" height="12" viewBox="0 0 14 14" aria-hidden="true"><path d="m2.5 7.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
              Your plan
            </span>
          {%- elsif block.settings.badge != blank -%}
            <span class="trh-mb__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          {%- if tier_image != blank -%}
            <div class="trh-mb__media">
              <img
                src="{{ tier_image | image_url: width: 700 }}"
                srcset="{{ tier_image | image_url: width: 350 }} 350w, {{ tier_image | image_url: width: 700 }} 700w"
                sizes="(max-width: 767px) 90vw, 300px"
                alt="{{ tier_name | escape }}"
                class="trh-mb__media-img"
                width="700" height="525" loading="lazy">
            </div>
          {%- endif -%}

          <h3 class="trh-mb__tier">{{ tier_name }}</h3>

          <div class="trh-mb__price">
            {%- if block.settings.price_override != blank -%}
              <span class="trh-mb__amount">{{ block.settings.price_override }}</span>
            {%- elsif tier_sub_price != blank -%}
              <span class="trh-mb__amount">{{ tier_sub_price | money }}</span>
            {%- elsif tier_product != blank -%}
              <span class="trh-mb__amount">{{ tier_product.price | money }}</span>
            {%- elsif request.design_mode -%}
              <span class="trh-mb__amount trh-mb__amount--placeholder">Pick a product</span>
            {%- endif -%}
            {%- if block.settings.price_suffix != blank -%}
              <span class="trh-mb__suffix">{{ block.settings.price_suffix }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.headline != blank -%}
            <p class="trh-mb__headline">{{ block.settings.headline }}</p>
          {%- endif -%}

          {%- if block.settings.perks != blank -%}
            {%- assign perk_lines = block.settings.perks | newline_to_br | split: '<br />' -%}
            <ul class="trh-mb__perks">
              {%- for perk in perk_lines -%}
                {%- assign perk_text = perk | strip -%}
                {%- if perk_text != blank -%}
                  <li>
                    <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true"><path d="m2.5 7.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
                    <span>{{ perk_text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="trh-mb__action">
            {%- if is_current -%}
              <span class="trh-mb__btn trh-mb__btn--current">Current plan</span>
            {%- elsif tier_product != blank -%}
              {%- assign tier_variant = tier_product.selected_or_first_available_variant -%}
              {%- if tier_variant.available -%}
                {%- if section.settings.button_action == 'product' -%}
                  <a href="{{ tier_product.url }}" class="trh-mb__btn trh-mb__btn--primary">
                    {{ block.settings.button_label | default: 'Join' }}
                  </a>
                {%- else -%}
                  <form method="post" action="{{ routes.cart_add_url }}">
                    <input type="hidden" name="id" value="{{ tier_variant.id }}">
                    <input type="hidden" name="quantity" value="1">
                    <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                    <button type="submit" class="trh-mb__btn trh-mb__btn--primary">
                      {{ block.settings.button_label | default: 'Join' }}
                    </button>
                  </form>
                {%- endif -%}
              {%- else -%}
                <span class="trh-mb__btn trh-mb__btn--current">Unavailable</span>
              {%- endif -%}
            {%- elsif block.settings.button_url != blank or block.settings.button_label != blank -%}
              {%- assign free_url = block.settings.button_url | default: routes.account_register_url -%}
              <a href="{{ free_url }}" class="trh-mb__btn trh-mb__btn--ghost">
                {{ block.settings.button_label | default: 'Join' }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_steps -%}
      <div class="trh-mb__steps">
        {%- if section.settings.step_1 != blank -%}
          <div class="trh-mb__step">
            <span class="trh-mb__step-num">1</span>
            <p>{{ section.settings.step_1 }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.step_2 != blank -%}
          <div class="trh-mb__step">
            <span class="trh-mb__step-num">2</span>
            <p>{{ section.settings.step_2 }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.step_3 != blank -%}
          <div class="trh-mb__step">
            <span class="trh-mb__step-num">3</span>
            <p>{{ section.settings.step_3 }}</p>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.fine_print != blank -%}
      <p class="trh-mb__fine">{{ section.settings.fine_print }}</p>
    {%- endif -%}

    {%- if section.settings.faq_url != blank or section.settings.terms_url != blank -%}
      <p class="trh-mb__links">
        {%- if section.settings.faq_url != blank -%}
          <a href="{{ section.settings.faq_url }}">Membership FAQ</a>
        {%- endif -%}
        {%- if section.settings.faq_url != blank and section.settings.terms_url != blank -%}
          <span aria-hidden="true">&middot;</span>
        {%- endif -%}
        {%- if section.settings.terms_url != blank -%}
          <a href="{{ section.settings.terms_url }}">Terms and Conditions</a>
        {%- endif -%}
      </p>
    {%- endif -%}

  </div>
</section>

<style>
{%- if settings.type_body_font -%}
  {{ settings.type_body_font | font_face: font_display: 'swap' }}
  {%- assign trh_mb_font = settings.type_body_font.family | append: ', ' | append: settings.type_body_font.fallback_families -%}
{%- else -%}
  {%- assign trh_mb_font = "'Inter', sans-serif" -%}
{%- endif -%}

#Membership-{{ section.id }} {
  --primary: #1e3a6f;
  --secondary: #2c5aa0;
  --accent: #4a7bc8;
  --text: #0f1e3d;
  --muted: #5a6a8a;
  --hover-bg: rgba(30, 58, 111, 0.06);
  --border: rgba(30, 58, 111, 0.14);
  --radius: 0px;
  --radius-sm: 0px;
  --font: {{ trh_mb_font }};
}

.trh-mb,
.trh-mb * {
  font-family: var(--font);
  box-sizing: border-box;
}

.trh-mb {
  padding: 0 0 4rem;
  background: #fff;
}

/* Banner */
.trh-mb__banner {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-bottom: 3rem;
}

.trh-mb__banner--small { min-height: 260px; }
.trh-mb__banner--medium { min-height: 380px; }
.trh-mb__banner--large { min-height: 520px; }

.trh-mb__banner-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.trh-mb__banner::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(10, 18, 40, calc(var(--trh-overlay) * 0.7)) 0%, rgba(10, 18, 40, var(--trh-overlay)) 100%);
}

.trh-mb__banner-inner {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem 1.5rem;
  max-width: 720px;
}

.trh-mb__kicker--banner { color: rgba(255, 255, 255, 0.85); }
.trh-mb__title--banner { color: #fff; }
.trh-mb__intro--banner { color: rgba(255, 255, 255, 0.9); }

.trh-mb__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* Head (no banner) */
.trh-mb__head {
  max-width: 640px;
  margin: 4rem auto 3rem;
  text-align: center;
}

.trh-mb__kicker {
  margin: 0 0 0.75rem;
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: var(--secondary);
}

.trh-mb__title {
  margin: 0;
  font-size: clamp(1.85rem, 3.5vw, 2.6rem);
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.01em;
  color: var(--text);
  line-height: 1.1;
}

.trh-mb__intro {
  margin: 1.25rem 0 0;
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
}

/* Sign-in reminder */
.trh-mb__signin-note {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  max-width: 720px;
  margin: 0 auto 2rem;
  padding: 0.85rem 1.1rem;
  background: var(--hover-bg);
  border-left: 4px solid var(--primary);
  font-size: 0.85rem;
  line-height: 1.5;
  font-weight: 600;
  color: var(--text);
}

.trh-mb__signin-note svg {
  flex-shrink: 0;
  margin-top: 2px;
  color: var(--primary);
}

/* Cards */
.trh-mb__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.25rem;
  align-items: stretch;
}

.trh-mb__card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 2rem 1.5rem 1.5rem;
  background: #fff;
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
}

.trh-mb__card:hover {
  border-color: var(--primary);
  box-shadow: 0 12px 32px rgba(30, 58, 111, 0.10);
  transform: translateY(-2px);
}

.trh-mb__card--featured {
  border-color: var(--primary);
  border-width: 2px;
  border-top: 4px solid var(--primary);
  box-shadow: 0 12px 32px rgba(30, 58, 111, 0.10);
}

.trh-mb__card--current {
  border-color: var(--secondary);
  border-left: 4px solid var(--secondary);
}

/* Badge chip */
.trh-mb__badge {
  position: absolute;
  top: -13px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.4rem 0.8rem;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  white-space: nowrap;
  box-shadow: 0 2px 8px rgba(30, 58, 111, 0.25);
}

.trh-mb__badge--current { background: var(--secondary); }

.trh-mb__media {
  position: relative;
  width: calc(100% + 3rem);
  margin: -2rem -1.5rem 1.5rem;
  overflow: hidden;
  background: #f5f7fa;
  isolation: isolate;
}

.trh-mb__media-img {
  width: 100%;
  height: auto;
  object-fit: contain;
  display: block;
}

.trh-mb__tier {
  margin: 0 0 1rem;
  font-size: 1rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--primary);
  padding-bottom: 0.75rem;
  border-bottom: 2px solid var(--border);
}

.trh-mb__price {
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  margin-bottom: 0.35rem;
}

.trh-mb__amount {
  font-size: 2.1rem;
  font-weight: 900;
  color: var(--text);
  line-height: 1;
}

.trh-mb__amount--placeholder {
  font-size: 1rem;
  font-weight: 700;
  color: var(--muted);
}

.trh-mb__suffix {
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--muted);
}

.trh-mb__compare {
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--muted);
  text-decoration: line-through;
  text-decoration-thickness: 1.5px;
}

.trh-mb__headline {
  margin: 0 0 1.25rem;
  font-size: 0.95rem;
  font-weight: 800;
  color: var(--secondary);
}

.trh-mb__perks {
  list-style: none;
  margin: 0 0 1.5rem;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.trh-mb__perks li {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  font-size: 0.9rem;
  line-height: 1.45;
  color: var(--text);
}

.trh-mb__perks svg {
  flex-shrink: 0;
  margin-top: 3px;
  color: var(--secondary);
}

/* Buttons */
.trh-mb__action { margin-top: auto; }
.trh-mb__action form { margin: 0; }

.trh-mb__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 0.95rem 1rem;
  border-radius: var(--radius);
  font-size: 0.85rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.15s;
}

.trh-mb__btn--primary {
  background: var(--primary);
  color: #fff;
  border: 1.5px solid var(--primary);
}

.trh-mb__btn--primary:hover {
  background: var(--secondary);
  border-color: var(--secondary);
  transform: translateY(-1px);
}

.trh-mb__btn--ghost {
  background: #fff;
  color: var(--primary);
  border: 1.5px solid var(--border);
}

.trh-mb__btn--ghost:hover {
  background: var(--hover-bg);
  border-color: var(--primary);
}

.trh-mb__btn--current {
  background: var(--hover-bg);
  color: var(--muted);
  border: 1.5px solid var(--border);
  cursor: default;
}

/* Steps */
.trh-mb__steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.25rem;
  margin-top: 3rem;
  padding-top: 2.5rem;
  border-top: 1px solid var(--border);
}

.trh-mb__step {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
}

.trh-mb__step-num {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  background: var(--primary);
  color: #fff;
  border-radius: var(--radius-sm);
  font-size: 0.85rem;
  font-weight: 800;
}

.trh-mb__step p {
  margin: 0.3rem 0 0;
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--text);
  font-weight: 600;
}

/* Fine print */
.trh-mb__fine {
  margin: 2.5rem auto 0;
  max-width: 720px;
  text-align: center;
  font-size: 0.8rem;
  line-height: 1.6;
  color: var(--muted);
}

.trh-mb__links {
  margin: 1rem auto 0;
  text-align: center;
  font-size: 0.85rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
}

.trh-mb__links a {
  color: var(--primary);
  font-weight: 700;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 0.78rem;
}

.trh-mb__links a:hover { text-decoration: underline; }
.trh-mb__links span { color: var(--border); }

@media (max-width: 767px) {
  .trh-mb { padding-bottom: 3rem; }
  .trh-mb__banner { margin-bottom: 2.25rem; }
  .trh-mb__banner--small,
  .trh-mb__banner--medium { min-height: 220px; }
  .trh-mb__banner--large { min-height: 320px; }
  .trh-mb__head { margin: 3rem auto 2.25rem; }
  .trh-mb__container { padding: 0 1rem; }
  .trh-mb__grid { gap: 1.5rem; }
  .trh-mb__card--featured { order: -1; }
}
</style>


<style>
/* ==========================================================================
   MEMBERSHIP PAGE, MATCHED TO THE CURRENT THEME. 2026-11-11, Todays Draft.
   Owner: restyle to match the rest of the site. The palette and moves are
   the ones the home page, the Team Stores page and the builder now share:
     deep #05101d  ink #0a1a2f  navy #0f2f66  blue #2b7fff
     cyan #06b6d4 (primary buttons)  orange #f47b20 (badges, hover block)
   Chivo for headings, the store's body face (Noto Sans Display) for text,
   square corners, no underlines, no decorative rules.
   Covers all three sections on the page (membership, savings, faq); each
   is variable driven, so most of this is new values for their variables.
   ========================================================================== */

html body .trh-mb, html body .trh-calc, html body .trh-faq {
  --primary: #0a1a2f !important;
  --secondary: #0f2f66 !important;
  --accent: #2b7fff !important;
  --electric: #0f2f66 !important;
  --volt: #f47b20 !important;
  --good: #0a1a2f !important;
  --text: #0a1a2f !important;
  --muted: #4a5568 !important;
}
html body .trh-mb a, html body .trh-calc a, html body .trh-faq a { text-decoration: none !important; }

/* Body copy in the body face, headings in Chivo. */
html body .trh-mb p, html body .trh-mb li,
html body .trh-calc p, html body .trh-faq p, html body .trh-faq__a {
  font-family: var(--typeBasePrimary, 'Noto Sans Display'), sans-serif !important;
  letter-spacing: normal !important;
}
html body .trh-mb__title, html body .trh-calc__title, html body .trh-faq__title {
  font-family: 'Chivo', sans-serif !important;
  font-weight: 900 !important;
  letter-spacing: -0.03em !important;
}

/* ------------------------------------------------- the header band */
html body .trh-mb__head {
  position: relative !important;
  background-color: #05101d !important;
  background-image:
    radial-gradient(55% 75% at 88% 18%, rgba(6,182,212,.22), transparent 70%),
    radial-gradient(45% 60% at 8% 100%, rgba(43,127,255,.30), transparent 70%),
    repeating-linear-gradient(115deg, rgba(255,255,255,.035) 0 2px, transparent 2px 26px) !important;
  box-shadow: 0 0 0 100vmax #05101d !important;
  clip-path: inset(0 -100vmax) !important;
  padding-top: 56px !important;
  padding-bottom: 48px !important;
  margin-bottom: 44px !important;
  color: #fff !important;
}
html body .trh-mb__head .trh-mb__kicker {
  display: inline-block !important;
  background: #06b6d4 !important;
  color: #05101d !important;
  padding: 6px 11px !important;
  font-weight: 800 !important;
  letter-spacing: .16em !important;
}
html body .trh-mb__head .trh-mb__title { color: #fff !important; font-size: clamp(38px, 5vw, 64px) !important; line-height: 1 !important; }
html body .trh-mb__head .trh-mb__intro { color: rgba(255,255,255,.78) !important; font-size: 17px !important; line-height: 1.6 !important; }
html body .trh-mb__head .trh-mb__signin-note {
  background: rgba(255,255,255,.07) !important;
  border: 1px solid rgba(255,255,255,.16) !important;
  border-left-width: 1px !important;
  color: rgba(255,255,255,.88) !important;
  border-radius: 0 !important;
  font-size: 15px !important;
  line-height: 1.55 !important;
}
html body .trh-mb__head .trh-mb__signin-note * { color: inherit !important; }

/* ------------------------------------------------------ tier cards */
html body .trh-mb__card { border-radius: 0 !important; border-color: #e3e9f2 !important; box-shadow: 0 1px 2px rgba(10,26,47,.05), 0 8px 24px rgba(10,26,47,.06) !important; }
html body .trh-mb__card--featured { border: 2px solid #0a1a2f !important; }
html body .trh-mb__badge { background: #f47b20 !important; color: #fff !important; border-radius: 0 !important; }
html body .trh-mb__badge--current { background: #06b6d4 !important; color: #05101d !important; }
html body .trh-mb__perks li { font-size: 15.5px !important; line-height: 1.5 !important; color: #26303d !important; }

html body .trh-mb__btn {
  border-radius: 0 !important;
  font-family: 'Chivo', sans-serif !important;
  font-weight: 900 !important;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease !important;
}
html body .trh-mb__btn--primary {
  background: #06b6d4 !important;
  border-color: #06b6d4 !important;
  color: #05101d !important;
}
html body .trh-mb__btn--primary:hover { transform: translate(-2px, -2px) !important; box-shadow: 6px 6px 0 0 #f47b20 !important; }
html body .trh-mb__btn--ghost { border-radius: 0 !important; }

html body .trh-mb__step-num { background: #0a1a2f !important; border-radius: 0 !important; }
html body .trh-mb__fine { font-size: 14px !important; line-height: 1.6 !important; color: #4a5568 !important; }

/* ----------------------------------------------- savings calculator */
html body .trh-calc__card { border-radius: 0 !important; }
html body .trh-calc__best { background: #0a1a2f !important; border-radius: 0 !important; }
html body .trh-calc__card--best { border-color: #0a1a2f !important; }
html body .trh-calc__intro, html body .trh-faq__intro { font-size: 17px !important; line-height: 1.6 !important; color: #4a5568 !important; }
html body .trh-calc__card-detail { font-size: 14px !important; line-height: 1.5 !important; color: #4a5568 !important; }

/* ------------------------------------------------------------- FAQ */
html body .trh-faq__q { font-family: 'Chivo', sans-serif !important; font-weight: 800 !important; font-size: 17px !important; }
html body .trh-faq__a, html body .trh-faq__a p { font-size: 16px !important; line-height: 1.65 !important; color: #26303d !important; }
/* The sign-in note sits under the band, not in it: a plain tinted box, no
   side rule, readable size. */
html body .trh-mb__signin-note {
  background: #f1f5fa !important;
  border: 1px solid #e3e9f2 !important;
  border-left-width: 1px !important;
  border-radius: 0 !important;
  color: #26303d !important;
  font-size: 15px !important;
  line-height: 1.55 !important;
}
</style>
