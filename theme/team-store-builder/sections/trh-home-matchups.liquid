{%- comment -%}
  sections/trh-home-matchups.liquid, The Run House
  Homepage "Toe to Toe" tiles, styled like the Collection tiles (square, full-bleed, white title at the bottom).
  Each tile is a navy-corner vs orange-corner face-off (Run House logo colors): the two shoes slide in when the row scrolls into view,
  then float. Hover lifts the tile like the other homepage tiles.
  Each block picks one of the matchup pages (/pages/...-vs-...) plus a short label.
  Shoe names come from snippets/trh-compare-pairs; cut-out shoe photos from snippets/trh-compare-cutouts
  (falls back to the regular photo from snippets/trh-compare-imgs).
{%- endcomment -%}
{%- capture trh_pairs -%}{%- render 'trh-compare-pairs' -%}{%- endcapture -%}
{%- assign trh_list = trh_pairs | strip | split: ';' -%}
{%- capture trh_cuts -%}{%- render 'trh-compare-cutouts' -%}{%- endcapture -%}
{%- assign trh_cl = trh_cuts | strip | split: ';' -%}
{%- capture trh_imgs -%}{%- render 'trh-compare-imgs' -%}{%- endcapture -%}
{%- assign trh_il = trh_imgs | strip | split: ';' -%}

<section class="tt" id="TT-{{ section.id }}" style="--tt-title-size: {{ section.settings.title_size }}px; --tt-panel-title-size: {{ section.settings.panel_title_size }}px; --tt-accent: {{ section.settings.accent_color }};">
  {%- if section.settings.title != blank -%}
    <h2 class="tt__title">{{ section.settings.title | escape }}</h2>
  {%- endif -%}
  {%- if section.settings.subtitle != blank or section.settings.button_label != blank -%}
    <p class="tt__sub">
      {{- section.settings.subtitle | escape -}}
      {%- if section.settings.button_label != blank %} <a href="{{ section.settings.button_link | default: '/pages/shoe-compare' }}">{{ section.settings.button_label | escape }}&nbsp;<span aria-hidden="true">&rarr;</span></a>{%- endif -%}
    </p>
  {%- endif -%}

  <div class="tt__grid">
    {%- for block in section.blocks -%}
      {%- assign pg = block.settings.page -%}
      {%- if pg == blank -%}{%- continue -%}{%- endif -%}
      {%- assign f = nil -%}
      {%- for e in trh_list -%}
        {%- assign ff = e | split: '|' -%}
        {%- if ff[0] == pg.handle -%}{%- assign f = ff -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
      {%- assign ia = '' -%}{%- assign ib = '' -%}{%- assign ca = false -%}{%- assign cb = false -%}
      {%- assign sa = pg.title -%}{%- assign sb = '' -%}{%- assign full = pg.title -%}
      {%- if f -%}
        {%- assign ka = f[1] | append: '|' -%}{%- assign kb = f[2] | append: '|' -%}
        {%- for im in trh_cl -%}
          {%- if im contains ka -%}{%- assign t = im | split: '|' -%}{%- if t[0] == f[1] -%}{%- assign ia = t[1] -%}{%- assign ca = true -%}{%- endif -%}{%- endif -%}
          {%- if im contains kb -%}{%- assign t = im | split: '|' -%}{%- if t[0] == f[2] -%}{%- assign ib = t[1] -%}{%- assign cb = true -%}{%- endif -%}{%- endif -%}
        {%- endfor -%}
        {%- if ia == '' or ib == '' -%}
          {%- for im in trh_il -%}
            {%- if ia == '' and im contains ka -%}{%- assign t = im | split: '|' -%}{%- if t[0] == f[1] -%}{%- assign ia = t[1] -%}{%- endif -%}{%- endif -%}
            {%- if ib == '' and im contains kb -%}{%- assign t = im | split: '|' -%}{%- if t[0] == f[2] -%}{%- assign ib = t[1] -%}{%- endif -%}{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- assign nm = f[3] | split: ' vs ' -%}
        {%- assign sa = nm[0] | replace: '-', '‑' -%}{%- assign sb = nm[1] | replace: '-', '‑' -%}
        {%- assign full = f[4] -%}
      {%- endif -%}
      <a href="{{ pg.url }}" class="tt__panel" style="--d: {{ forloop.index0 }};" aria-label="{{ full | escape }}" {{ block.shopify_attributes }}>
        <div class="tt__stage" aria-hidden="true">
          <span class="tt__shoe tt__shoe--a{% unless ca %} is-plain{% endunless %}">
            {%- if ia != '' -%}<img src="{{ ia }}&width=640" srcset="{{ ia }}&width=420 420w, {{ ia }}&width=640 640w, {{ ia }}&width=900 900w" sizes="(min-width: 990px) 22vw, (min-width: 600px) 40vw, 60vw" alt="" width="640" height="300" loading="lazy">{%- endif -%}
          </span>
          <span class="tt__shoe tt__shoe--b{% unless cb %} is-plain{% endunless %}">
            {%- if ib != '' -%}<img src="{{ ib }}&width=640" srcset="{{ ib }}&width=420 420w, {{ ib }}&width=640 640w, {{ ib }}&width=900 900w" sizes="(min-width: 990px) 22vw, (min-width: 600px) 40vw, 60vw" alt="" width="640" height="300" loading="lazy">{%- endif -%}
          </span>
          <span class="tt__vs">vs</span>
        </div>
        <div class="tt__overlay">
          {%- if block.settings.label != blank -%}<span class="tt__label">{{ block.settings.label | escape }}</span>{%- endif -%}
          <h3 class="tt__panel-title">{{ sa }}{% if sb != '' %} <span class="tt__v">vs</span> {{ sb }}{% endif %}</h3>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<script>
  (function () {
    var s = document.getElementById('TT-{{ section.id }}');
    if (!s || !('IntersectionObserver' in window)) { if (s) s.classList.add('is-in', 'is-live'); return; }
    s.classList.add('js-anim');
    new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting) s.classList.add('is-in');
        s.classList.toggle('is-live', e.isIntersecting);
      });
    }, { threshold: 0.12 }).observe(s);
  })();
</script>

{% stylesheet %}
  .tt { padding: 2rem 0; font-family: 'Chivo', sans-serif; width: 100%; }
  .tt__title { text-align: center; margin: 0 0 .35rem; font-size: clamp(30px, 3.4vw, 44px); font-weight: 900; letter-spacing: -.03em; line-height: 1.02; color: #0a1a2f; font-family: 'Chivo', sans-serif; }
  .tt__sub { text-align: center; margin: 0 auto 1rem; padding: 0 16px; max-width: 720px; font-size: 15px; line-height: 1.5; color: #4b5563; }
  .tt__sub a { color: #2b7fff; font-weight: 700; text-decoration: none; white-space: nowrap; }
  .tt__sub a:hover { color: #0a1a2f; }

  .tt__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .6rem; width: 100%; }

  .tt__panel {
    position: relative; display: block; overflow: hidden; aspect-ratio: 1 / 1; text-decoration: none; color: #fff;
    box-shadow: 0 6px 12px rgba(0, 0, 0, .12);
    transition: transform .4s cubic-bezier(.165, .84, .44, 1), box-shadow .4s ease;
    will-change: transform;
  }
  .tt__panel:hover { transform: translateY(-5px) scale(1.01); box-shadow: 0 10px 20px rgba(0, 0, 0, .2); z-index: 5; }

  /* Run House navy corner (top left) vs Run House orange corner (bottom right), with a light behind each shoe */
  .tt__stage {
    position: absolute; inset: 0; overflow: hidden;
    background:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, .30), rgba(255, 255, 255, 0) 36%),
      radial-gradient(circle at 70% 58%, rgba(255, 255, 255, .26), rgba(255, 255, 255, 0) 36%),
      linear-gradient(135deg, #0f2a55 0%, #05101d 49.6%, #ff8a1f 50.4%, #ff6a00 100%);
    transition: filter .4s ease;
  }
  .tt__panel:hover .tt__stage { filter: brightness(1.08) saturate(1.1); }

  /* Light sweep across the tile */
  .tt__stage::after {
    content: ''; position: absolute; top: -20%; bottom: -20%; left: -60%; width: 40%;
    background: linear-gradient(100deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, .16), rgba(255, 255, 255, 0));
    transform: translateX(0) skewX(-12deg); pointer-events: none;
  }

  .tt__shoe { position: absolute; width: 62%; display: block; z-index: 2; }
  .tt__shoe--a { left: 3%; top: 7%; }
  .tt__shoe--b { right: 2%; top: 41%; }
  .tt__shoe img {
    display: block; width: 100%; height: auto;
    filter: drop-shadow(0 14px 14px rgba(0, 0, 0, .45));
    transition: transform .45s cubic-bezier(.165, .84, .44, 1);
  }
  .tt__shoe--a img { transform: rotate(-7deg); }
  .tt__shoe--b img { transform: rotate(5deg); }
  .tt__panel:hover .tt__shoe--a img { transform: translate(5%, 4%) rotate(-4deg) scale(1.04); }
  .tt__panel:hover .tt__shoe--b img { transform: translate(-5%, -4%) rotate(2deg) scale(1.04); }
  /* Photo without a cut-out: show it on a white card */
  .tt__shoe.is-plain img { background: #fff; border-radius: 10px; padding: 4%; box-sizing: border-box; }

  .tt__vs {
    position: absolute; left: 50%; top: 40%; z-index: 3; width: 54px; height: 54px; margin: -27px 0 0 -27px;
    display: flex; align-items: center; justify-content: center; border-radius: 50%;
    background: #fff; color: #0a1a2f; font-size: 17px; font-weight: 900; letter-spacing: .02em; text-transform: uppercase;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, .25), 0 8px 18px rgba(0, 0, 0, .35);
  }

  .tt__overlay {
    position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: flex-end;
    padding: 1.5rem 1.25rem 1.35rem; text-align: center;
    background: linear-gradient(to top, rgba(0, 0, 0, .55) 0%, rgba(0, 0, 0, .3) 24%, rgba(0, 0, 0, 0) 46%);
    transition: background .4s ease;
  }
  .tt__panel:hover .tt__overlay { background: linear-gradient(to top, rgba(0, 0, 0, .45) 0%, rgba(0, 0, 0, .25) 24%, rgba(0, 0, 0, 0) 46%); }
  .tt__label {
    margin: 0 0 .45rem; padding: 4px 10px; background: rgba(255, 255, 255, .92); color: #0a1a2f;
    font-size: 11px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; line-height: 1.2;
  }
  .tt__panel-title {
    color: #fff; margin: 0; font-size: var(--tt-panel-title-size, 26px); font-weight: 900; line-height: 1.08; letter-spacing: -.01em;
    text-shadow: 0 2px 4px rgba(0, 0, 0, .85), 0 4px 12px rgba(0, 0, 0, .7), 0 0 24px rgba(0, 0, 0, .5);
    transform-origin: center bottom; transition: transform .4s ease;
  }
  .tt__v { font-size: .72em; font-weight: 600; opacity: .85; }
  .tt__panel:hover .tt__panel-title { transform: scale(1.05); }

  /* Pulsing accent border on hover, like the video tiles */
  .tt__panel:hover::before {
    content: ''; position: absolute; inset: 0; border: 2px solid var(--tt-accent, #ff6b6b); z-index: 11; pointer-events: none;
    animation: tt-pulse 2s infinite;
  }

  /* ---------- Movement ---------- */
  .tt.js-anim:not(.is-in) .tt__shoe--a { opacity: 0; transform: translateX(-60%); }
  .tt.js-anim:not(.is-in) .tt__shoe--b { opacity: 0; transform: translateX(60%); }
  .tt.js-anim:not(.is-in) .tt__vs { opacity: 0; transform: scale(.3); }
  .tt.is-in .tt__shoe--a {
    animation: tt-in-a .9s cubic-bezier(.2, .9, .25, 1.15) calc(var(--d) * 110ms) both,
               tt-float-a 4.6s ease-in-out calc(.9s + var(--d) * 110ms) infinite;
  }
  .tt.is-in .tt__shoe--b {
    animation: tt-in-b .9s cubic-bezier(.2, .9, .25, 1.15) calc(120ms + var(--d) * 110ms) both,
               tt-float-b 5.2s ease-in-out calc(1.02s + var(--d) * 110ms) infinite;
  }
  .tt.is-in .tt__vs {
    animation: tt-pop .5s cubic-bezier(.3, 1.6, .5, 1) calc(.55s + var(--d) * 110ms) both,
               tt-beat 2.6s ease-in-out calc(1.1s + var(--d) * 110ms) infinite;
  }
  .tt.is-in .tt__stage::after { animation: tt-sweep 7s ease-in-out calc(1.4s + var(--d) * 900ms) infinite; }
  .tt:not(.is-live) .tt__shoe, .tt:not(.is-live) .tt__vs, .tt:not(.is-live) .tt__stage::after { animation-play-state: paused; }

  @keyframes tt-in-a { from { opacity: 0; transform: translateX(-60%); } to { opacity: 1; transform: translateX(0); } }
  @keyframes tt-in-b { from { opacity: 0; transform: translateX(60%); } to { opacity: 1; transform: translateX(0); } }
  @keyframes tt-float-a { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(2.5%, -5%); } }
  @keyframes tt-float-b { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-2.5%, 5%); } }
  @keyframes tt-pop { from { opacity: 0; transform: scale(.3); } to { opacity: 1; transform: scale(1); } }
  @keyframes tt-beat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  @keyframes tt-sweep { 0% { transform: translateX(0) skewX(-12deg); } 30%, 100% { transform: translateX(420%) skewX(-12deg); } }
  @keyframes tt-pulse { 0%, 100% { opacity: .3; } 50% { opacity: .7; } }

  @media (prefers-reduced-motion: reduce) {
    .tt.js-anim .tt__shoe, .tt.js-anim .tt__vs { opacity: 1 !important; transform: none !important; animation: none !important; }
    .tt .tt__stage::after { display: none; }
    .tt__panel, .tt__shoe img, .tt__panel-title { transition: none; }
  }

  @media (max-width: 989px) {
    .tt__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .tt__title { font-size: calc(var(--tt-title-size, 32px) * .8); }
    .tt__sub { font-size: 14px; }
    .tt__grid {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none;
      gap: .6rem; padding: 0 0 6px;
    }
    .tt__grid::-webkit-scrollbar { display: none; }
    .tt__panel { flex: 0 0 82%; scroll-snap-align: center; }
    .tt__panel:first-child { margin-left: 9%; }
    .tt__panel:last-child { margin-right: 9%; }
    .tt__panel-title { font-size: calc(var(--tt-panel-title-size, 26px) * .85); }
    .tt__vs { width: 46px; height: 46px; margin: -23px 0 0 -23px; font-size: 15px; }
  }

  /* ---------- Home page colour match, 2026-11-11 ----------
     The team store banner's palette: navy #0a1a2f, deep #05101d, blue
     #2b7fff, cyan #06b6d4, orange #f47b20. */
  .tt { --tt-accent: #f47b20 !important; }

  /* ---------- HOUSE CALL band, home page only ----------
     The band is drawn by trh-housecall-promo-v2.js, a file in Shopify FILES
     that every theme loads (the live one included), so it is NOT edited.
     It inserts itself right before this section on the home page, so its
     restyle lives here and reaches this theme only. Owner's brief: the
     banner's colours, sharp corners, full page width, the same type.
     Higher specificity plus !important, because the script injects its
     own <style> into the head after this sheet. */
  html body main .trhp-band[data-trhp-band="home"] { padding: 0 !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-band__in {
    max-width: none !important;
    border-radius: 0 !important;
    background-color: #05101d !important;
    background-image:
      radial-gradient(55% 75% at 88% 18%, rgba(6,182,212,.22), transparent 70%),
      radial-gradient(45% 60% at 8% 100%, rgba(43,127,255,.30), transparent 70%),
      repeating-linear-gradient(115deg, rgba(255,255,255,.035) 0 2px, transparent 2px 26px) !important;
    padding: clamp(40px, 6vw, 84px) max(40px, calc((100vw - 1240px) / 2)) !important;
    font-family: 'Chivo', system-ui, sans-serif !important;
  }
  html body main .trhp-band[data-trhp-band="home"] .trhp-band__in::before { display: none !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-k { color: #f47b20 !important; font-family: 'Chivo', system-ui, sans-serif !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-t {
    font-family: 'Chivo', system-ui, sans-serif !important;
    font-style: normal !important;
    font-weight: 900 !important;
    text-transform: none !important;
    letter-spacing: -.035em !important;
    line-height: .98 !important;
    font-size: clamp(40px, 5vw, 66px) !important;
  }
  /* Single colour title (owner, 2026-11-11). */
  html body main .trhp-band[data-trhp-band="home"] .trhp-t em { font-style: normal !important; color: inherit !important; }
  /* No 01 / 02 / 03 on the points, the text stays. */
  html body main .trhp-band[data-trhp-band="home"] .trhp-pts i { display: none !important; }
  /* No arrow. "Start my House Call &rarr;" is TEXT in the shared script,
     which is not edited, so the label is redrawn without it: the link's own
     text is sized to nothing and the same words are set in its place. */
  html body main .trhp-band[data-trhp-band="home"] .trhp-b { font-size: 0 !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-b::before { content: 'Start my House Call'; font-size: 16px; line-height: 1; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-s,
  html body main .trhp-band[data-trhp-band="home"] .trhp-p,
  html body main .trhp-band[data-trhp-band="home"] .trhp-pts li { font-family: 'Chivo', system-ui, sans-serif !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-p { color: rgba(255,255,255,.74) !important; line-height: 1.6 !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-b {
    border-radius: 0 !important;
    background: #06b6d4 !important;
    color: #05101d !important;
    font-family: 'Chivo', system-ui, sans-serif !important;
    font-weight: 900 !important;
    box-shadow: none !important;
    border: 2px solid #06b6d4 !important;
    transition: transform .12s ease, box-shadow .12s ease !important;
  }
  html body main .trhp-band[data-trhp-band="home"] a.trhp-b:hover { transform: translate(-2px, -2px) !important; box-shadow: 6px 6px 0 0 #f47b20 !important; }
  html body main .trhp-band[data-trhp-band="home"] .trhp-pts li {
    border-radius: 0 !important;
    background: rgba(255,255,255,.06) !important;
    border: 1px solid rgba(255,255,255,.16) !important;
  }
  html body main .trhp-band[data-trhp-band="home"] .trhp-pts i { color: #f47b20 !important; font-style: normal !important; }
  @media (max-width: 768px) {
    html body main .trhp-band[data-trhp-band="home"] .trhp-band__in { padding: 40px 18px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Toe to Toe matchups",
  "tag": "div",
  "class": "trh-h2h-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Stuck Between Two Shoes?" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "See them toe to toe: feel, fit, specs and price, side by side." },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Compare any two shoes" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "range", "id": "title_size", "label": "Heading size", "min": 16, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "panel_title_size", "label": "Tile title size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 26 },
    { "type": "color", "id": "accent_color", "label": "Hover border color", "default": "#e17146" }
  ],
  "blocks": [
    {
      "type": "matchup",
      "name": "Matchup",
      "settings": [
        { "type": "page", "id": "page", "label": "Matchup page", "info": "Pick one of the Toe to Toe matchup pages (the ones named 'A vs B')." },
        { "type": "text", "id": "label", "label": "Label", "info": "Short category label, e.g. Daily trainers" }
      ]
    }
  ],
  "max_blocks": 9,
  "presets": [
    { "name": "Toe to Toe matchups" }
  ]
}
{% endschema %}
