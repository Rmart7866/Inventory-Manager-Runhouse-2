{%- capture trh_pairs -%}{%- render 'trh-compare-pairs' -%}{%- endcapture -%}
{%- assign trh_list = trh_pairs | strip | split: ';' -%}
{%- assign trh_a = '' -%}{%- assign trh_b = '' -%}
{%- assign trh_lab = '' -%}
{%- for e in trh_list -%}{%- assign f = e | split: '|' -%}{%- if f[0] == page.handle -%}{%- assign trh_a = f[1] -%}{%- assign trh_b = f[2] -%}{%- assign trh_lab = f[3] -%}{%- break -%}{%- endif -%}{%- endfor -%}
{%- if trh_a != '' -%}
{%- capture trh_imgs -%}{%- render 'trh-compare-imgs' -%}{%- endcapture -%}
{%- assign trh_il = trh_imgs | strip | split: ';' -%}
{%- for e in trh_il -%}{%- assign f = e | split: '|' -%}{%- if f[0] == trh_a or f[0] == trh_b -%}
<link rel="preload" as="image" href="{{ f[1] }}&width=420" imagesrcset="{{ f[1] }}&width=300 300w, {{ f[1] }}&width=420 420w, {{ f[1] }}&width=640 640w, {{ f[1] }}&width=800 800w" imagesizes="(min-width: 1000px) 376px, 37vw" fetchpriority="high">
{%- endif -%}{%- endfor -%}
{%- endif -%}
<div id="trh-compare" data-title="{{ page.title | escape }}" data-handle="{{ page.handle }}"><div class="trh-static"><h1>{{ page.title }}</h1>{{ page.content }}
{%- if page.handle == 'shoe-compare' -%}
{%- render 'trh-compare-hub' -%}
{%- elsif trh_a != '' -%}
{%- assign trh_names = trh_lab | split: ' vs ' -%}
<section class="trh-more"><h2>More head-to-heads</h2>
{%- for trh_s in (1..2) -%}
{%- if trh_s == 1 -%}{%- assign trh_id = trh_a -%}{%- assign trh_nm = trh_names[0] -%}{%- else -%}{%- assign trh_id = trh_b -%}{%- assign trh_nm = trh_names[1] -%}{%- endif -%}
{%- capture trh_ul -%}{%- for e in trh_list -%}{%- assign f = e | split: '|' -%}{%- if f[0] != page.handle -%}{%- if f[1] == trh_id or f[2] == trh_id -%}<li><a href="/pages/{{ f[0] }}">{{ f[4] }}</a></li>{%- endif -%}{%- endif -%}{%- endfor -%}{%- endcapture -%}
{%- if trh_ul != '' -%}<h3>More with the {{ trh_nm }}</h3><ul>{{ trh_ul }}</ul>{%- endif -%}
{%- endfor -%}
<p><a href="/pages/shoe-compare">See all head-to-heads</a></p></section>
{%- endif -%}
</div></div>
