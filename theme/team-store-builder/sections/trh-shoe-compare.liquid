<script>(function(){var r=document.getElementById('trh-compare');if(!r)return;r.classList.add('trh-wait');setTimeout(function(){if(!r.dataset.ready)r.classList.remove('trh-wait')},6000)})();</script>
<style>#trh-compare.trh-wait{min-height:100vh}#trh-compare.trh-wait .trh-static{display:none}#trh-compare .trh-static{max-width:980px;margin:0 auto;padding:28px 16px 64px}#trh-compare .trh-static table{border-collapse:collapse;width:100%;margin:12px 0}#trh-compare .trh-static th,#trh-compare .trh-static td{border:1px solid #d9dee8;padding:6px 10px;text-align:left;vertical-align:top}</style>
<script src="{{ 'trh-compare.js' | asset_url }}" defer></script>
<style id="trh-compare-read">
/* ==========================================================================
   SHOE COMPARE, READABILITY LAYER. 2026-11-11, Todays Draft Theme only.

   Owner: keep the colours, lose the random underlines and line accents, and
   above all make it readable; it reads as a wall of text. The page itself is
   drawn by assets/trh-compare.js (411 KB, CSS inside it), which is NOT
   edited: this sheet sits after it in the document and overrides it.

   What was measured before writing it (Clifton 11 vs Ghost 18):
     - every paragraph was CHIVO, the display face, at 16px with 0.45px of
       added tracking. Wide letters plus tracking at body size is what made
       it a wall. The store's own body face is Noto Sans Display
       (--typeBasePrimary); Chivo stays for headings, as on the rest of
       the site.
     - nine link styles drew underlines, and the accents were a two tone
       bar under every round heading, a two tone stripe down the short
       answer, coloured top rules on cards, coloured left rules on notes,
       colour bars under photos and hairlines either side of group labels.
     - the commonest small sizes were 13px and 12px in a mid grey.
   ========================================================================== */

/* ---------------------------------------------------------- body text */
html body #trh-compare .wrap { letter-spacing: normal !important; }
html body #trh-compare .wrap p,
html body #trh-compare .wrap li,
html body #trh-compare .wrap dd,
html body #trh-compare .wrap dt,
html body #trh-compare .wrap figcaption,
html body #trh-compare .wrap .pick li span {
  font-family: var(--typeBasePrimary, 'Noto Sans Display'), var(--typeBaseFallback, sans-serif) !important;
  letter-spacing: normal !important;
}
html body #trh-compare .voice p,
html body #trh-compare .newcol p,
html body #trh-compare .morecol p,
html body #trh-compare .fitnote p,
html body #trh-compare .two > p,
html body #trh-compare .vid p {
  font-size: 17px !important;
  line-height: 1.65 !important;
  color: #26303d !important;
  font-weight: 400 !important;
}
html body #trh-compare .sec > p,
html body #trh-compare p.size-say { max-width: 68ch !important; font-size: 17px !important; line-height: 1.65 !important; color: #26303d !important; }
html body #trh-compare .pick li { font-size: 16px !important; line-height: 1.55 !important; color: #26303d !important; margin-bottom: 6px !important; }
html body #trh-compare p.fine,
html body #trh-compare p.foot,
html body #trh-compare .rt p.rw,
html body #trh-compare p.missing,
html body #trh-compare p.bf-same { font-size: 14.5px !important; line-height: 1.55 !important; color: #4a5568 !important; }
html body #trh-compare .wrap p + p { margin-top: 0.75em !important; }

/* -------------------------------------------------------- no underlines */
html body #trh-compare a,
html body #trh-compare a:hover,
html body #trh-compare a:focus { text-decoration: none !important; }
/* A link still has to read as one: colour and weight do it now. */
html body #trh-compare .morelist a,
html body #trh-compare .mu-links a,
html body #trh-compare .mu-prev a,
html body #trh-compare .store p a,
html body #trh-compare .stores .st-c a,
html body #trh-compare .buy-msg a,
html body #trh-compare .trh-more a { color: #1f5fbf !important; font-weight: 700 !important; }
html body #trh-compare .vid-store,
html body #trh-compare .pick-cta { border-bottom: 0 !important; }

/* ---------------------------------------------------- no line accents */
html body #trh-compare .sec-h { border-top: 0 !important; padding-top: 0 !important; }
html body #trh-compare .sec-h h2::after,
html body #trh-compare .guide h2::after,
html body #trh-compare .verdict::after,
html body #trh-compare .kicker span::before,
html body #trh-compare .grp::before,
html body #trh-compare .grp::after { display: none !important; content: none !important; }
html body #trh-compare .photo,
html body #trh-compare .vid,
html body #trh-compare .slot.set { border-bottom: 0 !important; }
html body #trh-compare .deal,
html body #trh-compare .stackfig,
html body #trh-compare .g-src p { border-left: 0 !important; }
html body #trh-compare .g-steps li { border-top: 0 !important; }
html body #trh-compare .mu-meta,
html body #trh-compare .buy-panel { border-top-width: 1px !important; border-top-color: #e3e9f2 !important; }
html body #trh-compare .stick { border-bottom: 0 !important; box-shadow: 0 4px 14px rgba(10,17,36,.10) !important; }

/* --------------------------------------------------------------- layers */
/* Cards: one clean white panel each, lifted off the page by a soft shadow
   instead of a coloured rule. The shoe's colour stays in its marker square
   and its name. */
html body #trh-compare .pick,
html body #trh-compare .voice,
html body #trh-compare .newcol,
html body #trh-compare .morecol,
html body #trh-compare .fitnote {
  background: #fff !important;
  background-image: none !important;
  border: 1px solid #e3e9f2 !important;
  border-radius: 0 !important;
  box-shadow: 0 1px 2px rgba(10,26,47,.05), 0 8px 24px rgba(10,26,47,.06) !important;
  padding: 22px 24px !important;
}
html body #trh-compare .deal,
html body #trh-compare .stackfig { background: #eef3fa !important; padding: 18px 20px !important; }

/* Every other round sits on a full-width tinted band, so the page reads as
   a stack of distinct blocks rather than one long column. The band is drawn
   with a spread shadow clipped sideways, so it reaches the page edges
   without making the page scroll sideways. */
html body #trh-compare .wrap > .sec { padding-top: 48px !important; padding-bottom: 48px !important; margin-top: 0 !important; margin-bottom: 0 !important; }
html body #trh-compare .wrap > .sec:nth-child(odd) {
  background: #f1f5fa !important;
  box-shadow: 0 0 0 100vmax #f1f5fa !important;
  clip-path: inset(0 -100vmax) !important;
}
html body #trh-compare .sec-h { margin-bottom: 26px !important; }

@media (max-width: 700px) {
  html body #trh-compare .voice p,
  html body #trh-compare .newcol p,
  html body #trh-compare .morecol p,
  html body #trh-compare .fitnote p,
  html body #trh-compare .two > p,
  html body #trh-compare .sec > p,
  html body #trh-compare p.size-say { font-size: 16px !important; }
  html body #trh-compare .pick,
  html body #trh-compare .voice,
  html body #trh-compare .newcol,
  html body #trh-compare .morecol,
  html body #trh-compare .fitnote { padding: 18px !important; }
  html body #trh-compare .wrap > .sec { padding-top: 36px !important; padding-bottom: 36px !important; }
}

/* ==========================================================================
   ROUND TWO, same day. Owner: no glow on the short answer, and the text is
   still not readable enough. Measured on Superblast 3 vs Endorphin Speed 6:
     - the short answer set whole SENTENCES as 36px Chivo 800 headlines;
     - 24 kinds of text still sat under 15px: uppercase labels at 10.5 to
       12px, the spec labels at 13px in pale grey, the "Who it's for"
       runner descriptions at 14.5px grey, stock lines and chips at 13px.
   A floor of 13px for labels and 15 to 17px for anything you read.
   ========================================================================== */

/* The short answer: no glow, and sentences set as sentences. The shoe's
   name keeps the headline face and its colour, so it still pops. */
html body #trh-compare .verdict::before { display: none !important; content: none !important; }
html body #trh-compare .verdict .say {
  font-family: var(--typeBasePrimary, 'Noto Sans Display'), sans-serif !important;
  font-weight: 500 !important;
  font-size: clamp(20px, 2.2vw, 25px) !important;
  line-height: 1.4 !important;
  letter-spacing: normal !important;
}
html body #trh-compare .verdict .say a.shoplink {
  font-family: 'Chivo', sans-serif !important;
  font-weight: 800 !important;
  font-size: inherit !important;
  letter-spacing: -0.01em !important;
}
html body #trh-compare .verdict .eyebrow { font-size: 13px !important; }
html body #trh-compare .verdict { gap: 16px !important; }

/* Labels: uppercase, so 13px is the floor, and darker than before. */
html body #trh-compare .sub-h,
html body #trh-compare .bf-who,
html body #trh-compare h3.grp span,
html body #trh-compare .newcol h4,
html body #trh-compare .morecol h4,
html body #trh-compare .dial-k,
html body #trh-compare summary h4,
html body #trh-compare .cat-more,
html body #trh-compare .allpairs > summary { font-size: 13px !important; color: #3b4a63 !important; }
html body #trh-compare .scale span,
html body #trh-compare .odo-t b { font-size: 12.5px !important; }

/* Spec by spec: the middle labels and the small notes under values. */
html body #trh-compare .trow .lab { font-size: 14.5px !important; color: #3b4a63 !important; }
html body #trh-compare .v small { font-size: 13px !important; color: #4a5568 !important; }

/* Who it's for: each runner reads as its own short block. */
html body #trh-compare #who .rt { margin-bottom: 22px !important; }
html body #trh-compare #who .rt b,
html body #trh-compare #who .rt strong,
html body #trh-compare #who .rt h4 { font-size: 18px !important; color: #0a1a2f !important; }
html body #trh-compare #who .rt p.rw { font-size: 16px !important; line-height: 1.55 !important; color: #26303d !important; }
html body #trh-compare #who p.why,
html body #trh-compare #who p.why span { font-size: 16px !important; line-height: 1.55 !important; }

/* Everything else that sat at 13 to 14px. */
html body #trh-compare .mu-stock,
html body #trh-compare .mu-links a,
html body #trh-compare .t-note,
html body #trh-compare .chip,
html body #trh-compare .pick-cta { font-size: 14px !important; }
html body #trh-compare .dial-diff,
html body #trh-compare .dial-r .who,
html body #trh-compare .st-c a,
html body #trh-compare label.tog { font-size: 15px !important; }
html body #trh-compare .morelist a,
html body #trh-compare #more li a { font-size: 16px !important; }
/* The last four under the 13px floor, found by sweeping every text node. */
html body #trh-compare .mu-brand,
html body #trh-compare .buy-open,
html body #trh-compare .t-cap,
html body #trh-compare .wl { font-size: 13px !important; }
</style>
