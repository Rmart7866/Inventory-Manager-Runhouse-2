{% comment %}
  Team Stores
  sections/team-stores.liquid

  DIRECTORY DATA SOURCE
  Generated from the "Team Store" toggle (custom.team_store) on each collection.
  The team-stores Cloudflare Worker compiles the list into the page metafield
  custom.team_stores. There is no handle list in this file.

  To add or remove a store: open the collection in Shopify admin and flip the
  Team Store toggle under Metafields.

  This section reads page.metafields, so it must sit on the page whose handle
  the Worker writes to (default: team-stores).

  CARD IMAGES
  Each card shows the collection's own image when it is a logo file (PNG, SVG,
  WEBP, GIF). JPG collection images are usually photos, so those cards use the
  first product's image instead (no team photos on this page). No image at all
  falls back to the big initial. To change a card's picture, change the
  collection image in Shopify admin.

  LOAD-IN DISABLED
{% endcomment %}

{%- assign ts_data = page.metafields.custom.team_stores.value -%}
{%- assign ts_stores = ts_data.stores -%}
{%- assign ts_count = ts_stores | size -%}
{%- assign sid = section.id -%}
{%- comment -%}
  Card images precomputed by tools/team-store-card-images.mjs into
  custom.team_store_images, "L|<url>" (the collection's logo) or "P|<url>"
  (first product photo). The live page timed out (500, 3,003 ms) looking up
  every store's collection, and every JPG store's products, on each render.
  A store missing from the map falls back to the old lookup below.
{%- endcomment -%}
{%- assign ts_imgs = page.metafields.custom.team_store_images.value -%}

{%- assign gallery_count = 0 -%}
{%- assign feature_count = 0 -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'gallery_image' -%}{%- assign gallery_count = gallery_count | plus: 1 -%}{%- endif -%}
  {%- if block.type == 'team_store' -%}{%- assign feature_count = feature_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} Logo wall: sample logos evenly across the whole A-Z list. {%- endcomment -%}
{%- assign ts_wall_n = 0 -%}
{%- assign ts_wall_a = '' -%}
{%- assign ts_wall_b = '' -%}
{%- assign ts_wall_c = '' -%}
{%- assign ts_wall_d = '' -%}
{%- if section.settings.show_logo_wall and ts_count > 0 -%}
  {%- assign ts_step = ts_count | divided_by: 48 | at_least: 1 -%}
  {%- for store in ts_stores -%}
    {%- if ts_wall_n >= 20 -%}{%- break -%}{%- endif -%}
    {%- assign ts_mod = forloop.index0 | modulo: ts_step -%}
    {%- if ts_mod != 0 -%}{%- continue -%}{%- endif -%}
    {%- assign ts_m = nil -%}
    {%- if ts_imgs -%}{%- assign ts_m = ts_imgs[store.h] -%}{%- endif -%}
    {%- if ts_m -%}
      {%- assign ts_kind = ts_m | slice: 0 -%}
      {%- if ts_kind != 'L' -%}{%- continue -%}{%- endif -%}
      {%- assign ts_wurl = ts_m | remove_first: 'L|' | append: '?width=260' -%}
    {%- else -%}
      {%- assign wc = collections[store.h] -%}
      {%- if wc == blank or wc.image == blank -%}{%- continue -%}{%- endif -%}
      {%- assign w_ext = wc.image.src | split: '?' | first | split: '.' | last | downcase -%}
      {%- if w_ext == 'jpg' or w_ext == 'jpeg' -%}{%- continue -%}{%- endif -%}
      {%- assign ts_wurl = wc.image | image_url: width: 260 -%}
    {%- endif -%}
    {%- capture ts_tile -%}<a href="/collections/{{ store.h }}" class="ts-wall-tile" tabindex="-1"><img src="{{ ts_wurl }}" alt="" width="130" height="130"></a>{%- endcapture -%}
    {%- assign ts_col = ts_wall_n | modulo: 4 -%}
    {%- case ts_col -%}
      {%- when 0 -%}{%- assign ts_wall_a = ts_wall_a | append: ts_tile -%}
      {%- when 1 -%}{%- assign ts_wall_b = ts_wall_b | append: ts_tile -%}
      {%- when 2 -%}{%- assign ts_wall_c = ts_wall_c | append: ts_tile -%}
      {%- else -%}{%- assign ts_wall_d = ts_wall_d | append: ts_tile -%}
    {%- endcase -%}
    {%- assign ts_wall_n = ts_wall_n | plus: 1 -%}
  {%- endfor -%}
{%- endif -%}
{%- assign ts_has_wall = false -%}
{%- if ts_wall_n >= 12 -%}{%- assign ts_has_wall = true -%}{%- endif -%}

<style>

  #ts-{{ sid }} {
    --ts-header-offset: {{ section.settings.header_offset }}px;

    --ts-ink:    {{ section.settings.text_color }};
    --ts-deep:   {{ section.settings.dark_color }};
    --ts-accent: {{ section.settings.accent_color }};
    --ts-glow:   {{ section.settings.highlight_color }};
    --ts-pop:    {{ section.settings.pop_color | default: '#f47b20' }};
    --ts-accent-wash: {{ section.settings.accent_color | color_modify: 'alpha', 0.09 }};
    --ts-glow-soft:   {{ section.settings.highlight_color | color_modify: 'alpha', 0.22 }};
    --ts-accent-soft: {{ section.settings.accent_color | color_modify: 'alpha', 0.30 }};

    --ts-mid:   #55637a;
    --ts-low:   #97a2b3;
    --ts-rule:  #d5dae2;
    --ts-wash:  #f2f4f7;
    --ts-tile:  #f6f8fb;
    --ts-paper: #ffffff;

    font-family: 'Chivo', system-ui, sans-serif;
    background: {{ section.settings.section_bg }};
    color: var(--ts-ink);
    isolation: isolate;
    position: relative;
    z-index: 1;
  }

  #ts-{{ sid }} *,
  #ts-{{ sid }} *::before,
  #ts-{{ sid }} *::after { box-sizing: border-box; }

  #ts-{{ sid }} h1,
  #ts-{{ sid }} h2,
  #ts-{{ sid }} h3,
  #ts-{{ sid }} p {
    margin: 0;
    padding: 0;
    font-family: 'Chivo', system-ui, sans-serif !important;
  }

  #ts-{{ sid }} .ts-wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
  }

  #ts-{{ sid }} .ts-kicker {
    display: inline-block;
    padding: 6px 11px;
    background: var(--ts-deep);
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ts-glow) !important;
    margin-bottom: 18px !important;
  }

  #ts-{{ sid }} .ts-dark .ts-kicker {
    background: var(--ts-glow);
    color: var(--ts-deep) !important;
  }

  #ts-{{ sid }} .ts-h2 {
    font-size: clamp(28px, 3.4vw, 42px) !important;
    font-weight: 900 !important;
    letter-spacing: -0.028em;
    line-height: 1.05 !important;
    color: var(--ts-ink) !important;
    margin-bottom: 36px !important;
  }

  #ts-{{ sid }} .ts-h2 em { font-style: normal; color: var(--ts-accent); }

  /* -------------------------------------------------------------- hero */

  #ts-{{ sid }} .ts-hero {
    position: relative;
    width: 100%;
    height: 560px;
    overflow: hidden;
    background: var(--ts-deep);
    border-bottom: 3px solid var(--ts-deep);
  }

  #ts-{{ sid }} .ts-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.15) contrast(1.08) brightness(0.86);
  }

  #ts-{{ sid }} .ts-hero-plate {
    position: absolute;
    left: 40px;
    bottom: 40px;
    max-width: 780px;
    padding: 36px 40px;
    background: var(--ts-deep);
  }

  #ts-{{ sid }} .ts-hero-plate h1 {
    font-size: clamp(32px, 4.4vw, 54px) !important;
    font-weight: 900 !important;
    letter-spacing: -0.032em;
    line-height: 1 !important;
    color: #fff !important;
    margin-bottom: 14px !important;
  }

  #ts-{{ sid }} .ts-hero-plate p {
    font-size: 17px !important;
    line-height: 1.5 !important;
    color: rgba(255,255,255,0.72) !important;
  }

  /* ------------------------------------------------ CTA / opening band */

  #ts-{{ sid }} .ts-cta {
    position: relative;
    overflow: hidden;
    background: var(--ts-deep);
    border-bottom: 3px solid var(--ts-deep);
    padding: 84px 0 92px;
  }

  /* Glow plus diagonal speed lines, so the band is never a flat slab. */
  #ts-{{ sid }} .ts-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 75% at 88% 18%, var(--ts-glow-soft), transparent 70%),
      radial-gradient(45% 60% at 8% 100%, var(--ts-accent-soft), transparent 70%),
      repeating-linear-gradient(115deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 26px);
    pointer-events: none;
  }

  #ts-{{ sid }} .ts-cta-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.08fr 1fr;
    gap: 64px;
    align-items: center;
  }

  #ts-{{ sid }} .ts-cta.no-wall .ts-cta-inner { grid-template-columns: 1fr; max-width: 820px; }

  #ts-{{ sid }} .ts-cta h1,
  #ts-{{ sid }} .ts-cta h2 {
    font-size: clamp(36px, 5vw, 66px) !important;
    font-weight: 900 !important;
    letter-spacing: -0.035em;
    line-height: 0.98 !important;
    color: #fff !important;
    margin-bottom: 20px !important;
  }

  /* No underline under the title, owner 2026-11-11. */
  #ts-{{ sid }} .ts-cta h1 em,
  #ts-{{ sid }} .ts-cta h2 em {
    font-style: normal;
    color: var(--ts-glow);
  }

  #ts-{{ sid }} .ts-cta p {
    font-size: 17px !important;
    line-height: 1.6 !important;
    color: rgba(255,255,255,0.74) !important;
    max-width: 58ch;
  }

  #ts-{{ sid }} .ts-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  #ts-{{ sid }} .ts-mail,
  #ts-{{ sid }} .ts-jump {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 24px;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration: none !important;
    word-break: break-word;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease, box-shadow 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-mail {
    background: var(--ts-glow);
    border: 2px solid var(--ts-glow);
    color: var(--ts-deep) !important;
  }

  #ts-{{ sid }} .ts-mail::after {
    content: '\2192';
    font-weight: 900;
    transition: transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-mail:hover {
    background: var(--ts-glow);
    color: var(--ts-deep) !important;
    box-shadow: 6px 6px 0 0 var(--ts-pop);
    transform: translate(-2px, -2px);
  }

  #ts-{{ sid }} .ts-mail:hover::after { transform: translateX(4px); }

  #ts-{{ sid }} .ts-jump {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.32);
    color: #fff !important;
  }

  #ts-{{ sid }} .ts-jump::after { content: '\2193'; font-weight: 900; transition: transform 0.12s ease; }

  #ts-{{ sid }} .ts-jump:hover { border-color: #fff; }
  #ts-{{ sid }} .ts-jump:hover::after { transform: translateY(3px); }

  /* When the builder button leads, the email steps down to the same outline
     as "Find your team" so the row has one primary action, not two. */
  #ts-{{ sid }} .ts-mail-alt {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.32);
    color: #fff !important;
  }
  #ts-{{ sid }} .ts-mail-alt::after { content: none; }
  #ts-{{ sid }} .ts-mail-alt:hover { border-color: #fff; background: transparent; box-shadow: none; transform: none; }

  #ts-{{ sid }} .ts-stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 40px;
    margin-top: 44px;
    padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,0.14);
  }

  #ts-{{ sid }} .ts-stat b {
    display: block;
    font-size: 30px;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  #ts-{{ sid }} .ts-stat:first-child b { color: var(--ts-pop); }

  #ts-{{ sid }} .ts-stat span {
    display: block;
    margin-top: 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.55);
  }

  /* Logo wall: real team logos drifting past, tilted like a stack of tags. */
  #ts-{{ sid }} .ts-wall {
    position: relative;
    height: 540px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    transform: rotate(-6deg);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
            mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
  }

  #ts-{{ sid }} .ts-wall-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 16px;
    animation: ts-rise-{{ sid }} 42s linear infinite;
    will-change: transform;
  }

  #ts-{{ sid }} .ts-wall-col:nth-child(2) { animation-duration: 54s; animation-direction: reverse; }
  #ts-{{ sid }} .ts-wall-col:nth-child(3) { animation-duration: 48s; }
  #ts-{{ sid }} .ts-wall:hover .ts-wall-col { animation-play-state: paused; }

  @keyframes ts-rise-{{ sid }} {
    from { transform: translateY(0); }
    to   { transform: translateY(-50%); }
  }

  #ts-{{ sid }} .ts-wall-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    padding: 16%;
    background: #fff;
    border: 2px solid #fff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  #ts-{{ sid }} .ts-wall-tile:nth-child(3n+1) { box-shadow: 6px 6px 0 0 var(--ts-glow); }
  #ts-{{ sid }} .ts-wall-tile:nth-child(3n+2) { box-shadow: 6px 6px 0 0 var(--ts-pop); }
  #ts-{{ sid }} .ts-wall-tile:hover { transform: scale(1.04); }

  #ts-{{ sid }} .ts-wall-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* ----------------------------------------------------- how it works */

  #ts-{{ sid }} .ts-steps-band { padding: 84px 0 88px; }

  #ts-{{ sid }} .ts-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    counter-reset: ts-step;
  }

  #ts-{{ sid }} .ts-step {
    position: relative;
    padding: 30px 28px 32px;
    background: var(--ts-paper);
    border: 2px solid var(--ts-deep);
    transition: box-shadow 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-step:hover {
    box-shadow: 8px 8px 0 0 var(--ts-glow);
    transform: translate(-3px, -3px);
  }

  #ts-{{ sid }} .ts-step::before {
    counter-increment: ts-step;
    content: '0' counter(ts-step);
    position: absolute;
    top: -2px;
    right: -2px;
    padding: 8px 12px;
    background: var(--ts-deep);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    color: var(--ts-glow);
  }

  #ts-{{ sid }} .ts-step-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 22px;
    background: var(--ts-accent-wash);
    color: var(--ts-accent);
  }

  #ts-{{ sid }} .ts-step:nth-child(2) .ts-step-icon { color: var(--ts-pop); background: rgba(244, 123, 32, 0.1); }

  #ts-{{ sid }} .ts-step-icon svg { width: 28px; height: 28px; }

  #ts-{{ sid }} .ts-step h3 {
    font-size: 21px !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em;
    line-height: 1.15 !important;
    color: var(--ts-ink) !important;
    margin-bottom: 10px !important;
  }

  #ts-{{ sid }} .ts-step p {
    font-size: 15px !important;
    line-height: 1.6 !important;
    color: var(--ts-mid) !important;
  }

  /* ----------------------------------------------------------- gallery */

  #ts-{{ sid }} .ts-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 80px 0;
  }

  #ts-{{ sid }} .ts-gallery-item {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 2px solid var(--ts-deep);
    transition: box-shadow 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-gallery-item:hover {
    box-shadow: 8px 8px 0 0 var(--ts-glow);
    transform: translate(-3px, -3px);
  }

  #ts-{{ sid }} .ts-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.2) contrast(1.06);
  }

  #ts-{{ sid }} .ts-gallery-cap {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 10px 14px;
    background: var(--ts-deep);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ts-glow);
  }

  /* ---------------------------------------------------------- featured */

  #ts-{{ sid }} .ts-features { padding: 0 0 72px; }

  #ts-{{ sid }} .ts-feature {
    position: relative;
    height: 460px;
    margin-bottom: 24px;
    overflow: hidden;
    border: 2px solid var(--ts-deep);
    background: var(--ts-deep);
  }

  #ts-{{ sid }} .ts-feature:last-child { margin-bottom: 0; }

  #ts-{{ sid }} .ts-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.15) contrast(1.06) brightness(0.9);
  }

  #ts-{{ sid }} .ts-feature-plate {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: 640px;
    padding: 30px 36px;
    background: var(--ts-deep);
  }

  #ts-{{ sid }} .ts-feature-plate h3 {
    font-size: 28px !important;
    font-weight: 900 !important;
    letter-spacing: -0.025em;
    color: #fff !important;
    margin-bottom: 10px !important;
  }

  #ts-{{ sid }} .ts-feature-plate p {
    font-size: 15px !important;
    line-height: 1.55 !important;
    color: rgba(255,255,255,0.72) !important;
  }

  /* --------------------------------------------------------- directory */

  #ts-{{ sid }} .ts-dir-band {
    background: var(--ts-wash);
    border-top: 3px solid var(--ts-deep);
    padding: 80px 0 96px;
    scroll-margin-top: var(--ts-header-offset);
  }

  #ts-{{ sid }} .ts-dir-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 26px;
  }

  #ts-{{ sid }} .ts-dir-head .ts-h2 { margin-bottom: 0 !important; }

  #ts-{{ sid }} .ts-dir-help {
    flex: none;
    font-size: 14px !important;
    line-height: 1.5 !important;
    color: var(--ts-mid) !important;
    text-align: right;
  }

  #ts-{{ sid }} .ts-dir-help a {
    color: var(--ts-ink) !important;
    font-weight: 700;
    text-decoration: underline !important;
    text-decoration-color: var(--ts-pop) !important;
    text-decoration-thickness: 2px !important;
    text-underline-offset: 3px;
  }

  #ts-{{ sid }} .ts-search {
    position: sticky;
    top: var(--ts-header-offset);
    z-index: 20;
    padding: 12px 0;
    background: var(--ts-wash);
  }

  #ts-{{ sid }} .ts-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  #ts-{{ sid }} .ts-field > svg {
    position: absolute;
    left: 20px;
    width: 20px;
    height: 20px;
    color: var(--ts-low);
    pointer-events: none;
    transition: color 0.12s ease;
  }

  #ts-{{ sid }} .ts-field:focus-within > svg { color: var(--ts-accent); }

  #ts-{{ sid }} .ts-input {
    width: 100% !important;
    height: 64px;
    padding: 0 60px 0 54px !important;
    font-family: 'Chivo', system-ui, sans-serif !important;
    font-size: 17px !important;
    font-weight: 500 !important;
    color: var(--ts-ink) !important;
    background: var(--ts-paper) !important;
    border: 2px solid var(--ts-deep) !important;
    border-radius: 0 !important;
    outline: none !important;
    margin: 0 !important;
    box-shadow: 5px 5px 0 0 var(--ts-deep) !important;
    transition: border-color 0.12s ease, box-shadow 0.12s ease;
  }

  #ts-{{ sid }} .ts-input::placeholder { color: var(--ts-low) !important; font-weight: 400 !important; }

  #ts-{{ sid }} .ts-input:focus {
    border-color: var(--ts-deep) !important;
    box-shadow: 5px 5px 0 0 var(--ts-glow) !important;
  }

  #ts-{{ sid }} .ts-clear {
    position: absolute;
    right: 12px;
    display: none;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    font-size: 20px;
    line-height: 1;
    color: var(--ts-deep);
    background: var(--ts-wash);
    border: 0;
    border-radius: 0;
    cursor: pointer;
    transition: background 0.12s ease, color 0.12s ease;
  }

  #ts-{{ sid }} .ts-clear:hover { background: var(--ts-deep); color: var(--ts-glow); }
  #ts-{{ sid }} .ts-clear.is-on { display: flex; }

  #ts-{{ sid }} .ts-tally {
    padding: 18px 0 22px;
    font-size: 12px !important;
    font-weight: 700 !important;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ts-mid) !important;
    font-variant-numeric: tabular-nums;
  }

  #ts-{{ sid }} .ts-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
  }

  /* Card: logo tile on top, name bar below. */
  #ts-{{ sid }} .ts-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--ts-paper);
    border: 2px solid var(--ts-deep);
    text-decoration: none !important;
    color: var(--ts-ink) !important;
    transition: box-shadow 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-card.is-hidden { display: none; }

  #ts-{{ sid }} .ts-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    padding: 13% 16%;
    overflow: hidden;
    background: var(--ts-tile);
    border-bottom: 2px solid var(--ts-deep);
  }

  #ts-{{ sid }} .ts-media img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.2s ease;
  }

  /* Ghosted initial sits behind every logo; it carries the tile when there is no image. */
  #ts-{{ sid }} .ts-initial {
    position: absolute;
    right: -6px;
    bottom: -30px;
    font-size: 132px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.06em;
    color: var(--ts-accent);
    opacity: 0.05;
    pointer-events: none;
    user-select: none;
    transition: color 0.12s ease, opacity 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-media.is-blank {
    background:
      repeating-linear-gradient(115deg, var(--ts-accent-wash) 0 2px, transparent 2px 18px),
      var(--ts-tile);
  }

  #ts-{{ sid }} .ts-media.is-blank .ts-initial {
    right: auto;
    bottom: auto;
    position: relative;
    font-size: 96px;
    opacity: 0.28;
  }

  #ts-{{ sid }} .ts-card-body {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 14px 15px 16px;
    transition: background 0.12s ease, color 0.12s ease;
  }

  #ts-{{ sid }} .ts-card-name {
    font-size: 14.5px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  #ts-{{ sid }} .ts-card-go {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    font-size: 15px;
    font-weight: 900;
    background: var(--ts-wash);
    color: var(--ts-deep);
    transition: background 0.12s ease, transform 0.12s ease;
  }

  #ts-{{ sid }} .ts-card:hover,
  #ts-{{ sid }} .ts-card:focus-visible {
    box-shadow: 8px 8px 0 0 var(--ts-pop);
    transform: translate(-3px, -3px);
    text-decoration: none !important;
    outline: none;
  }

  #ts-{{ sid }} .ts-card:hover .ts-card-body,
  #ts-{{ sid }} .ts-card:focus-visible .ts-card-body {
    background: var(--ts-deep);
    color: #fff;
  }

  #ts-{{ sid }} .ts-card:hover .ts-card-go,
  #ts-{{ sid }} .ts-card:focus-visible .ts-card-go {
    background: var(--ts-pop);
    transform: translateX(2px);
  }

  #ts-{{ sid }} .ts-card:hover .ts-media img { transform: scale(1.06); }

  #ts-{{ sid }} .ts-card:hover .ts-initial,
  #ts-{{ sid }} .ts-card:focus-visible .ts-initial { opacity: 0.16; transform: translate(-4px, 4px); }

  /* ------------------------------------------------------------- empty */

  #ts-{{ sid }} .ts-empty {
    display: none;
    padding: 80px 24px;
    text-align: center;
    border: 2px solid var(--ts-deep);
    background: var(--ts-paper);
  }

  #ts-{{ sid }} .ts-empty.is-on { display: block; }

  #ts-{{ sid }} .ts-empty-head {
    font-size: 22px !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em;
    margin-bottom: 8px !important;
  }

  #ts-{{ sid }} .ts-empty-sub {
    font-size: 15px !important;
    color: var(--ts-mid) !important;
  }

  #ts-{{ sid }} .ts-empty-sub a { color: var(--ts-ink) !important; font-weight: 700; }

  #ts-{{ sid }} .ts-pending {
    padding: 80px 24px;
    text-align: center;
    color: var(--ts-mid) !important;
    border: 2px dashed var(--ts-rule);
  }

  /* -------------------------------------------------------- responsive */

  @media (max-width: 1100px) {
    #ts-{{ sid }} .ts-cta-inner { grid-template-columns: 1fr; gap: 48px; }
    #ts-{{ sid }} .ts-wall { height: 300px; grid-template-columns: repeat(4, 1fr); transform: rotate(-4deg); margin: 0 -20px; }
    #ts-{{ sid }} .ts-wall-col:nth-child(4) { animation-duration: 50s; animation-direction: reverse; }
    #ts-{{ sid }} .ts-grid { grid-template-columns: repeat(4, 1fr); }
    #ts-{{ sid }} .ts-gallery { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    #ts-{{ sid }} .ts-grid { grid-template-columns: repeat(3, 1fr); }
    #ts-{{ sid }} .ts-steps { grid-template-columns: 1fr; gap: 16px; }
  }

  @media (min-width: 1101px) {
    #ts-{{ sid }} .ts-wall-col:nth-child(4) { display: none; }
  }

  @media (max-width: 768px) {
    #ts-{{ sid }} .ts-wrap { padding: 0 18px; }

    #ts-{{ sid }} .ts-hero { height: 400px; }
    #ts-{{ sid }} .ts-hero-plate {
      left: 0;
      right: 0;
      bottom: 0;
      max-width: none;
      padding: 24px 20px;
    }

    #ts-{{ sid }} .ts-cta { padding: 52px 0 40px; }
    #ts-{{ sid }} .ts-cta p { font-size: 16px !important; }
    #ts-{{ sid }} .ts-actions { margin-top: 26px; }
    #ts-{{ sid }} .ts-mail,
    #ts-{{ sid }} .ts-jump { font-size: 15px; padding: 15px 18px; }
    #ts-{{ sid }} .ts-stats { gap: 22px; margin-top: 32px; padding-top: 20px; }
    #ts-{{ sid }} .ts-stat b { font-size: 22px; }
    #ts-{{ sid }} .ts-stat span { font-size: 10px; letter-spacing: 0.1em; }
    #ts-{{ sid }} .ts-wall { height: 220px; gap: 12px; }
    #ts-{{ sid }} .ts-wall-col { gap: 12px; padding-bottom: 12px; }

    #ts-{{ sid }} .ts-steps-band { padding: 56px 0; }
    #ts-{{ sid }} .ts-step { padding: 24px 22px 26px; }

    #ts-{{ sid }} .ts-gallery { grid-template-columns: 1fr; padding: 48px 0; }
    #ts-{{ sid }} .ts-feature { height: 340px; }
    #ts-{{ sid }} .ts-feature-plate { max-width: none; right: 0; padding: 22px 20px; }
    #ts-{{ sid }} .ts-feature-plate h3 { font-size: 22px !important; }

    #ts-{{ sid }} .ts-dir-band { padding: 52px 0 64px; }
    #ts-{{ sid }} .ts-dir-head { flex-direction: column; align-items: flex-start; gap: 10px; }
    #ts-{{ sid }} .ts-dir-help { text-align: left; }
    #ts-{{ sid }} .ts-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    #ts-{{ sid }} .ts-card-body { padding: 11px 10px 12px 12px; }
    #ts-{{ sid }} .ts-card-name { font-size: 13px; }
    #ts-{{ sid }} .ts-card-go { display: none; }
    #ts-{{ sid }} .ts-initial { font-size: 96px; bottom: -22px; }
    #ts-{{ sid }} .ts-media.is-blank .ts-initial { font-size: 72px; }
    #ts-{{ sid }} .ts-input { height: 56px; font-size: 16px !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    #ts-{{ sid }} *,
    #ts-{{ sid }} *::before,
    #ts-{{ sid }} *::after { transition: none !important; animation: none !important; }
  }
</style>

<div id="ts-{{ sid }}" class="ts" data-ts-root>

  <!-- Hero -->
  {%- if section.settings.hero_image != blank -%}
    <div class="ts-hero">
      <img src="{{ section.settings.hero_image | image_url: width: 2400 }}"
           alt="{{ section.settings.section_heading | escape }}"
           width="{{ section.settings.hero_image.width }}"
           height="{{ section.settings.hero_image.height }}">
      <div class="ts-hero-plate">
        <h1>{{ section.settings.section_heading }}</h1>
        {%- if section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    THE BUILDER IS THE PRIMARY WAY TO START A STORE, the email is the
    fallback. The link resolves through the pages object rather than a typed
    path, so an unpublished or renamed page yields blank and the button is
    simply not rendered, and every "Start a store" link falls back to the
    email, rather than becoming a dead link. builder_link overrides it.
  {%- endcomment -%}
  {%- assign builder_url = section.settings.builder_link -%}
  {%- if builder_url == blank -%}
    {%- assign builder_url = pages['build-your-store'].url -%}
  {%- endif -%}
  {%- if builder_url != blank -%}
    {%- assign start_url = builder_url -%}
  {%- elsif section.settings.contact_email != blank -%}
    {%- assign start_url = 'mailto:' | append: section.settings.contact_email -%}
  {%- else -%}
    {%- assign start_url = '' -%}
  {%- endif -%}

  <!-- Create your team store -->
  <div class="ts-cta ts-dark{% unless ts_has_wall %} no-wall{% endunless %}">
    <div class="ts-wrap">
      <div class="ts-cta-inner">
        <div>
          <p class="ts-kicker">Get Started</p>
          {%- if section.settings.hero_image != blank -%}<h2>Create your <em>team store</em></h2>{%- else -%}<h1>Create your <em>team store</em></h1>{%- endif -%}
          {%- if section.settings.contact_blurb != blank -%}
            <p>{{ section.settings.contact_blurb }}</p>
          {%- endif -%}
          <div class="ts-actions">
            {%- if builder_url != blank -%}
              <a href="{{ builder_url }}" class="ts-mail ts-build">{{ section.settings.builder_label | default: 'Build your store' }}</a>
            {%- endif -%}
            {%- if section.settings.contact_email != blank -%}
              <a href="mailto:{{ section.settings.contact_email }}" class="ts-mail{% if builder_url != blank %} ts-mail-alt{% endif %}">{{ section.settings.contact_email }}</a>
            {%- endif -%}
            {%- if section.settings.show_directory and ts_count > 0 -%}
              <a href="#ts-dir-{{ sid }}" class="ts-jump">Find your team</a>
            {%- endif -%}
          </div>
          {%- if section.settings.show_stats -%}
            <div class="ts-stats">
              {%- if ts_count > 0 -%}
                <div class="ts-stat"><b>{{ ts_count }}</b><span>Team stores</span></div>
              {%- endif -%}
              {%- if section.settings.stat_2_value != blank -%}
                <div class="ts-stat"><b>{{ section.settings.stat_2_value }}</b><span>{{ section.settings.stat_2_label }}</span></div>
              {%- endif -%}
              {%- if section.settings.stat_3_value != blank -%}
                <div class="ts-stat"><b>{{ section.settings.stat_3_value }}</b><span>{{ section.settings.stat_3_label }}</span></div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if ts_has_wall -%}
          <div class="ts-wall" aria-hidden="true">
            <div class="ts-wall-col">{{ ts_wall_a }}{{ ts_wall_a }}</div>
            <div class="ts-wall-col">{{ ts_wall_b }}{{ ts_wall_b }}</div>
            <div class="ts-wall-col">{{ ts_wall_c }}{{ ts_wall_c }}</div>
            <div class="ts-wall-col">{{ ts_wall_d }}{{ ts_wall_d }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <!-- How it works -->
  {%- if section.settings.show_steps -%}
    <div class="ts-steps-band">
      <div class="ts-wrap">
        <p class="ts-kicker">How It Works</p>
        <h2 class="ts-h2">{{ section.settings.steps_heading }}</h2>
        <div class="ts-steps">
          <div class="ts-step">
            <div class="ts-step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="m3 7 9 6 9-6"/></svg>
            </div>
            <h3>{{ section.settings.step_1_title }}</h3>
            <p>{{ section.settings.step_1_text }}</p>
          </div>
          <div class="ts-step">
            <div class="ts-step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3 4 5.5 2.5 10l3 1.2V21h13v-9.8l3-1.2L20 5.5 16 3c-.6 1.6-2.2 2.6-4 2.6S8.6 4.6 8 3Z"/><path d="M9.5 13h5M12 13v4"/></svg>
            </div>
            <h3>{{ section.settings.step_2_title }}</h3>
            <p>{{ section.settings.step_2_text }}</p>
          </div>
          <div class="ts-step">
            <div class="ts-step-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6h11v10H2zM13 9h4.5l3.5 3.5V16h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
            </div>
            <h3>{{ section.settings.step_3_title }}</h3>
            <p>{{ section.settings.step_3_text }}</p>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="ts-wrap">

    <!-- Gallery -->
    {%- if gallery_count > 0 -%}
      <div class="ts-gallery">
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' and block.settings.image != blank -%}
            <div class="ts-gallery-item" {{ block.shopify_attributes }}>
              <img src="{{ block.settings.image | image_url: width: 900 }}"
                   alt="{{ block.settings.caption | escape }}"
                   loading="lazy"
                   width="{{ block.settings.image.width }}"
                   height="{{ block.settings.image.height }}">
              {%- if block.settings.caption != blank -%}
                <span class="ts-gallery-cap">{{ block.settings.caption }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Featured stores -->
    {%- if feature_count > 0 -%}
      <div class="ts-features">
        {%- for block in section.blocks -%}
          {%- if block.type == 'team_store' -%}
            <div class="ts-feature" {{ block.shopify_attributes }}>
              {%- if block.settings.store_image != blank -%}
                <img src="{{ block.settings.store_image | image_url: width: 1800 }}"
                     alt="{{ block.settings.store_title | escape }}"
                     loading="lazy">
              {%- endif -%}
              <div class="ts-feature-plate">
                <h3>{{ block.settings.store_title }}</h3>
                {%- if block.settings.store_description != blank -%}
                  <p>{{ block.settings.store_description }}</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>

  <!-- Directory -->
  {%- if section.settings.show_directory -%}
    <div class="ts-dir-band" id="ts-dir-{{ sid }}">
      <div class="ts-wrap">
        <p class="ts-kicker">Directory</p>
        <div class="ts-dir-head">
          {%- if section.settings.directory_heading != blank -%}
            <h2 class="ts-h2">{{ section.settings.directory_heading }}</h2>
          {%- endif -%}
          {%- if start_url != blank -%}
            <p class="ts-dir-help">Don't see your team? <a href="{{ start_url }}">Start a store</a></p>
          {%- endif -%}
        </div>

        {%- if ts_count > 0 -%}

          <div class="ts-search">
            <div class="ts-field">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="8.5" cy="8.5" r="5.5"/>
                <path d="M12.7 12.7 17 17" stroke-linecap="round"/>
              </svg>
              <input type="text"
                     id="ts-input-{{ sid }}"
                     class="ts-input"
                     data-ts-input
                     placeholder="Search {{ ts_count }} team stores"
                     autocomplete="off"
                     spellcheck="false"
                     aria-label="Search team stores">
              <button type="button" class="ts-clear" data-ts-clear aria-label="Clear search">&times;</button>
            </div>
          </div>

          <p class="ts-tally" data-ts-tally aria-live="polite">Showing all {{ ts_count }} team stores</p>

          <div class="ts-grid" data-ts-grid>
            {%- for store in ts_stores -%}
              {%- assign ts_img = nil -%}
              {%- assign ts_iurl = nil -%}
              {%- assign ts_m = nil -%}
              {%- if ts_imgs -%}{%- assign ts_m = ts_imgs[store.h] -%}{%- endif -%}
              {%- if ts_m -%}
                {%- assign ts_iurl = ts_m | slice: 2, 2000 | append: '?width=420' -%}
              {%- else -%}
                {%- assign c = collections[store.h] -%}
                {%- if c != blank -%}
                  {%- if c.image != blank -%}
                    {%- assign ts_ext = c.image.src | split: '?' | first | split: '.' | last | downcase -%}
                    {%- unless ts_ext == 'jpg' or ts_ext == 'jpeg' -%}
                      {%- assign ts_img = c.image -%}
                    {%- endunless -%}
                  {%- endif -%}
                  {%- if ts_img == blank and c.products_count > 0 -%}
                    {%- assign ts_img = c.products.first.featured_image -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if ts_img != blank -%}{%- assign ts_iurl = ts_img | image_url: width: 420 -%}{%- endif -%}
              {%- endif -%}
              <a href="/collections/{{ store.h }}"
                 class="ts-card"
                 data-search="{{ store.t | downcase | append: ' ' | append: store.h | replace: '-', ' ' | escape }}">
                <span class="ts-media{% if ts_iurl == blank %} is-blank{% endif %}">
                  <span class="ts-initial" aria-hidden="true">{{ store.t | slice: 0 | upcase }}</span>
                  {%- if ts_iurl != blank -%}
                    <img src="{{ ts_iurl }}" alt="" loading="lazy" width="210" height="158">
                  {%- endif -%}
                </span>
                <span class="ts-card-body">
                  <span class="ts-card-name">{{ store.t }}</span>
                  <span class="ts-card-go" aria-hidden="true">&rarr;</span>
                </span>
              </a>
            {%- endfor -%}
          </div>

          <div class="ts-empty" data-ts-empty>
            <p class="ts-empty-head">No teams match <span data-ts-term></span></p>
            <p class="ts-empty-sub">Try the school name, the town, or the sport.{% if start_url != blank %} Still nothing? <a href="{{ start_url }}">Start a store</a>.{% endif %}</p>
          </div>

        {%- else -%}

          <div class="ts-pending">
            <p>The team store list is being rebuilt. Check back in a few minutes.</p>
          </div>

        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

</div>

<script>
(function () {
  'use strict';

  function boot(root) {
    if (root.dataset.tsReady === '1') return;
    root.dataset.tsReady = '1';

    var input = root.querySelector('[data-ts-input]');
    var clear = root.querySelector('[data-ts-clear]');
    var tally = root.querySelector('[data-ts-tally]');
    var grid  = root.querySelector('[data-ts-grid]');
    var empty = root.querySelector('[data-ts-empty]');
    var term  = root.querySelector('[data-ts-term]');

    if (!input || !grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll('.ts-card'));
    var total = cards.length;

    // Cache the match strings once. A keystroke never reads the DOM.
    var haystack = cards.map(function (el) { return el.getAttribute('data-search') || ''; });

    function filter() {
      var q = input.value.toLowerCase().trim();
      var shown = 0;

      clear.classList.toggle('is-on', q.length > 0);

      for (var i = 0; i < total; i++) {
        var hit = q === '' || haystack[i].indexOf(q) !== -1;
        cards[i].classList.toggle('is-hidden', !hit);
        if (hit) shown++;
      }

      if (shown === 0 && q !== '') {
        grid.style.display = 'none';
        empty.classList.add('is-on');
        if (term) term.textContent = '"' + input.value.trim() + '"';
        tally.textContent = 'No matches';
      } else {
        grid.style.display = '';
        empty.classList.remove('is-on');
        tally.textContent = q === ''
          ? 'Showing all ' + total + ' team stores'
          : shown + ' of ' + total + ' team stores';
      }
    }

    function reset() {
      input.value = '';
      filter();
      input.focus();
    }

    input.addEventListener('input', filter);
    clear.addEventListener('click', reset);

    input.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { reset(); return; }
      if (e.key === 'Enter') {
        var first = grid.querySelector('.ts-card:not(.is-hidden)');
        if (first) { e.preventDefault(); window.location.href = first.href; }
      }
    });

    // "/" jumps to search from anywhere on the page.
    document.addEventListener('keydown', function (e) {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      var t = e.target.tagName;
      if (t === 'INPUT' || t === 'TEXTAREA' || e.target.isContentEditable) return;
      e.preventDefault();
      input.focus();
      input.select();
    });
  }

  function init() { document.querySelectorAll('[data-ts-root]').forEach(boot); }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  document.addEventListener('shopify:section:load', function (e) {
    var root = e.target.querySelector('[data-ts-root]');
    if (root) boot(root);
  });
})();
</script>

{% schema %}
{
  "name": "Team Stores",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The directory is generated from the Team Store toggle on each collection. To add or remove a store, open the collection and flip that toggle. This section must sit on the page the Worker writes to."
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Hero Heading",
      "default": "Team Stores"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Hero Description",
      "default": "Permanent online stores for your school, club, or organization. Open 24/7, so members order branded gear whenever they need it."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Store Directory"
    },
    {
      "type": "checkbox",
      "id": "show_directory",
      "label": "Show Store Directory",
      "default": true
    },
    {
      "type": "text",
      "id": "directory_heading",
      "label": "Directory Heading",
      "default": "Find your team"
    },
    {
      "type": "range",
      "id": "header_offset",
      "label": "Sticky header height",
      "info": "Raise this if your theme header is sticky, so the search bar does not tuck underneath it.",
      "min": 0,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "textarea",
      "id": "contact_blurb",
      "label": "Contact Blurb",
      "default": "Chat with us today to set up a custom team store for your organization. We offer customization options like names and numbers, and a wide range of products including apparel, hats, water bottles, and more. Custom orders typically ship within 5–7 business days."
    },
    {
      "type": "text",
