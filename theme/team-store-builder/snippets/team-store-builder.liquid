function hexrgb(h){h=(h||'#888888').replace('#','');return[parseInt(h.slice(0,2),16),parseInt(h.slice(2,4),16),parseInt(h.slice(4,6),16)]}
function vis(L,g){if(!L||!L.smp||!L.smp.length)return 0.5;var n=0;for(var i=0;i<L.smp.length;i++){var q=L.smp[i],dr=q[0]-g[0],dg=q[1]-g[1],db=q[2]-g[2];n+=Math.min(160,Math.sqrt(.3*dr*dr+.59*dg*dg+.11*db*db))}return n/L.smp.length/160}
