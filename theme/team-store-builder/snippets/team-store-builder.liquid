function fpct(){if(S.mode==='upd')return 0;var f=parseFloat(S.team.fund);return isFinite(f)&&f>0?Math.min(f,100):0}
function price(p,x){x=x&&p.loc&&Object.keys(p.loc).length;var b=p.m+(x?3:0);var f=fpct();return f?Math.ceil(b*(1+f/100)):b}
function money(n){return'$'+(Math.round(n*100)%100?n.toFixed(2):Math.round(n))}
function fundNote(p,x){var f=fpct();if(!f)return'';var d=price(p,x)-(p.m+(x?3:0));return d>0?'<span class="fund">incl. '+money(d)+' for your team</span>':''}

