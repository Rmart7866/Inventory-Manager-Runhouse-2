function bestIn(p,code){var b=-1,br=1e9;if(!code)return-1;for(var i=0;i<p.c.length;i++){var k=p.c[i];if(k[8]===code&&(k[9]||0)<br){br=k[9]||0;b=i}}return b}
function logoVis(hex){var g=hexrgb(hex),Ls=LK.map(function(k){return S.logos[k]}).filter(function(L){return L&&L.smp&&L.smp.length});if(!Ls.length)return-1;return Math.max.apply(null,Ls.map(function(L){return vis(L,g)}))}
