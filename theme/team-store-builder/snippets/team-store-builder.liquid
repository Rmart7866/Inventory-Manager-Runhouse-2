function rec(p){if(RC[p.s])return RC[p.s];var c=S.col,out=[],em=eff('m'),es=eff('s');
  [em&&em.code,es&&es.code].forEach(function(f){var i=bestIn(p,f);if(i>=0&&out.indexOf(i)<0)out.push(i)});
  var team=out.length,max=team?Math.min(4,team+2):3;
