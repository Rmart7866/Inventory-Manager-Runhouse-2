function famRGB(r,g,b){r/=255;g/=255;b/=255;var mx=Math.max(r,g,b),mn=Math.min(r,g,b),l=(mx+mn)/2,d=mx-mn,s=d?d/(1-Math.abs(2*l-1)):0,h=0;
  if(d){if(mx===r)h=60*(((g-b)/d)%6);else if(mx===g)h=60*((b-r)/d+2);else h=60*((r-g)/d+4)}if(h<0)h+=360;
  if(s<0.15||l<0.12||l>0.9){if(l<0.18)return'BK';if(l>0.86)return'WH';return l<0.45?'CH':'GH'}
  if(l<0.3&&h>190&&h<260)return'NV';if(h<12||h>345)return l<0.33?'MR':(l>0.65?'PK':'RD');if(h<40)return(s<0.45||l<0.35)?'BR':'OR';
  if(h<65)return s<0.5?'VG':'GD';if(h<85)return'LM';if(h<165)return l<0.3?'FG':(l>0.6?'LM':'KG');if(h<200)return'TL';
  if(h<250)return l<0.3?'NV':(l>0.6?'LB':'RY');if(h<300)return'PU';return'PK'}
function autoColors(){if(S.col.user||S.col.fromStore)return;var Ls=[S.logos.main,S.logos.dark].filter(function(L){return L&&L.smp&&L.smp.length});if(!Ls.length)return;
  var cnt={},tot=0;Ls[0].smp.forEach(function(q){var f=famRGB(q[0],q[1],q[2]);cnt[f]=(cnt[f]||0)+1;tot++});
  var chrom=Object.keys(cnt).filter(function(f){return['BK','WH','GH','CH'].indexOf(f)<0&&cnt[f]/tot>=0.06}).sort(function(a,b){return cnt[b]-cnt[a]});
  var m='',s='';if(chrom.length){m=chrom[0];s=chrom[1]||((cnt.BK||0)/tot>0.15?'BK':'')}else{m=(cnt.BK||0)>=(cnt.GH||0)+(cnt.CH||0)?'BK':'CH'}
