{%- if trh_on -%}
<div id="trh-enh-top" class="trh-enh">
  {%- if trh_tiles -%}
  <section class="trh-sf" id="spike-finder" aria-label="Spike Finder">
    <div class="trh-sf__head">
      <p class="trh-sf__eyebrow">Spike Finder</p>
