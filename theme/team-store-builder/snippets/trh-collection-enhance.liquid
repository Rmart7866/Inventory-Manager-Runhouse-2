<script>
(function(){
  var top = document.getElementById('trh-enh-top');
  var ajax = document.getElementById('CollectionAjaxContent');
  if (top && ajax) ajax.insertBefore(top, ajax.firstChild);
  var HANDLE = {{ collection.handle | json }};

  /* ---------- filter inputs ---------- */
  function inputsFor(f){
    return Array.prototype.slice.call(document.querySelectorAll(f === 'width' ? 'input[name="width"]' : 'input[data-filter="' + f + '"]'));
  }
  function inputFor(f, v){
    var l = inputsFor(f);
    for (var i = 0; i < l.length; i++) if (l[i].value === v) return l[i];
    return null;
  }
  function countOf(inp){
    var lab = inp.id ? document.querySelector('label[for="' + inp.id + '"]') : null;
    var c = lab && lab.querySelector('.item-count');
    return c ? parseInt(c.textContent, 10) || 0 : 0;
  }

  /* ---------- quick chips, built from the filters this page actually has ---------- */
  var chipsBox = document.querySelector('.trh-chips');
  function buildChips(){
    if (!chipsBox || chipsBox.dataset.built) return;
    var chips = [];
    var types = inputsFor('type').map(function(i){ return i.value; });
    if (types.indexOf("Women's Shoes") > -1 && types.indexOf("Men's Shoes") > -1) {
      chips.push(['type', "Women's Shoes", "Women's"], ['type', "Men's Shoes", "Men's"]);
    }
    var widths = inputsFor('width').map(function(i){ return i.value; });
    if (widths.length > 1) {
      ['Narrow', 'Wide', 'Extra Wide'].forEach(function(w){ if (widths.indexOf(w) > -1) chips.push(['width', w, w]); });
    }
    var vendors = inputsFor('vendor');
    if (vendors.length > 1) {
      vendors.slice().sort(function(a, b){ return countOf(b) - countOf(a); }).slice(0, 5).forEach(function(i){ chips.push(['vendor', i.value, i.value]); });
    }
    if (!types.length && !vendors.length) return; // filters not built yet
    chipsBox.dataset.built = '1';
    if (chips.length < 2) return;
    chips.forEach(function(c){
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'trh-chip';
      b.dataset.f = c[0]; b.dataset.v = c[1]; b.textContent = c[2];
      b.addEventListener('click', function(){
        var inp = inputFor(b.dataset.f, b.dataset.v);
        if (!inp) return;
        inp.checked = !inp.checked;
        inp.dispatchEvent(new Event('change', { bubbles: true }));
        syncChips();
      });
      chipsBox.appendChild(b);
    });
    chipsBox.hidden = false;
  }
  function syncChips(){
    document.querySelectorAll('.trh-chip').forEach(function(b){
      var inp = inputFor(b.dataset.f, b.dataset.v);
      b.classList.toggle('is-on', !!(inp && inp.checked));
      b.hidden = !inp;
    });
  }
  document.addEventListener('change', function(){ setTimeout(syncChips, 0); });
  window.addEventListener('filtersChanged', function(){ setTimeout(syncChips, 0); });

  /* ---------- filters: gender and width first ---------- */
  function reorderFilters(){
    var size = document.getElementById('sizeSection');
    var width = document.getElementById('widthSection');
    var typeOpts = document.getElementById('typeOptions');
    if (!size || !typeOpts) return;
    var type = typeOpts.closest('.filter-section');
    var lbl = type && type.querySelector('.section-label span');
    var tv = inputsFor('type').map(function(i){ return i.value; }).join('|');
    if (lbl && lbl.textContent.trim() === 'Type' && /Men's Shoes/.test(tv) && /Women's Shoes/.test(tv)) lbl.textContent = "Men's / Women's";
    if (type && type !== size.previousElementSibling) size.parentNode.insertBefore(type, size);
    if (width && width !== size.previousElementSibling) size.parentNode.insertBefore(width, size);
  }

  /* ---------- cards ---------- */
  var grid = document.getElementById('productGrid');
  if (!grid) return;
  var sortMode = 'featured';
  var WRANK = { 'Narrow': 0, 'Standard': 1, 'Wide': 2, 'X-Wide': 3 };
  var WMAP = { narrow: 'Narrow', standard: 'Standard', wide: 'Wide', xwide: 'X-Wide', 'extra-wide': 'X-Wide' };
  var VENDORS = ['new balance', 'on running', 'under armour', 'asics', 'hoka', 'brooks', 'saucony', 'altra', 'puma', 'merrell', 'mizuno', 'diadora', 'nike', 'adidas', 'on'];

  // handle -> {key, width} from the cw-group tag
  var tagMap = null;
  function buildTagMap(){
    var s = window.ShoeCollectionFilter && window.ShoeCollectionFilter.getState && window.ShoeCollectionFilter.getState();
    if (!s || !s.allProducts || !s.allProducts.length) return;
    tagMap = {};
    s.allProducts.forEach(function(p){
      var tags = Array.isArray(p.tags) ? p.tags : String(p.tags || '').split(',');
      for (var i = 0; i < tags.length; i++) {
        var t = String(tags[i]).trim();
        if (t.indexOf('cw-group:') !== 0) continue;
        var k = t.slice(9), w = 'standard', j = k.lastIndexOf('--');
        if (j > 0) { w = k.slice(j + 2); k = k.slice(0, j); }
        k = k.replace(/(^|-)fresh-foam-x-/, '$1');
        tagMap[p.handle] = { key: k, width: WMAP[w] || 'Standard' };
        break;
      }
    });
  }
  function handleOf(href){
    var m = String(href || '').match(/\/products\/([^/?#]+)/);
    return m ? decodeURIComponent(m[1]) : '';
  }
  function widthOf(t){
    if (/extra[\s-]?wide|\bx-?wide\b|\b4e\b|\b6e\b/i.test(t)) return 'X-Wide';
    if (/\bwide\b/i.test(t)) return 'Wide';
    if (/\bnarrow\b/i.test(t)) return 'Narrow';
    return 'Standard';
  }
  function cleanTitle(t, vendor){
    var s = String(t || '');
    s = s.replace(/\s*\([^)]*\)/g, ' ');
    var cut = s.search(/\s[-–]\s|[^\s-]-\s+(?=[A-Za-z])/);
    if (cut > 0) s = s.slice(0, s.charAt(cut) === ' ' ? cut : cut + 1);
    s = s.replace(/\b(?:extra[\s-]?wide|x-?wide|wide|narrow)\b/gi, ' ');
    var vs = VENDORS.slice(); if (vendor) vs.unshift(String(vendor).toLowerCase());
    for (var i = 0; i < vs.length; i++) {
      var re = new RegExp('(^|\\s)' + vs[i].replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '(?=\\s)', 'i');
      if (re.test(' ' + s + ' ') && s.replace(re, ' ').trim().length > 3) { s = s.replace(re, ' '); break; }
    }
    s = s.replace(/\bwomens\b/gi, "Women's").replace(/\bmens\b/gi, "Men's");
    s = s.split(' ').map(function(tok){
      var letters = tok.replace(/[^A-Za-z]/g, '');
      if (letters.length >= 5 && letters === letters.toUpperCase() && !/\d/.test(tok)) return tok.toLowerCase().replace(/(^|-)([a-z])/g, function(m, a, b){ return a + b.toUpperCase(); });
      return tok;
    }).join(' ');
    s = s.replace(/\bGt-/g, 'GT-').replace(/\bGts\b/g, 'GTS').replace(/\bGtx\b/g, 'GTX');
    return s.replace(/\s+/g, ' ').replace(/[\s\-–,]+$/, '').trim();
  }
  function priceOf(card){
    var p = card.querySelector('.product-price');
    return p ? parseFloat(p.textContent.replace(/[^0-9.]/g, '')) || 0 : 0;
  }
  function swatchesOf(m){
    var out = [];
    var row = m.card.querySelector('.cw-swatches');
    if (row) row.querySelectorAll('a.cw-swatch').forEach(function(a){ out.push({ href: a.getAttribute('href'), img: (a.querySelector('img') || {}).src || '', label: a.getAttribute('aria-label') || '' }); });
    else if (m.href) out.push({ href: m.href, img: (m.card.querySelector('.product-image') || {}).src || '', label: m.raw });
    return out;
  }

  var obs;
  function enhance(){
    if (obs) obs.disconnect();
    try {
      if (!tagMap) buildTagMap();
      // The House Call tile (.trhp-tile, from the shared Files script) also
      // carries .product-card. It is never one of ours: sorting it moved it,
      // the House Call script moved it back, and each move re-ran this, so
      // the grid redrew about 8 times a second for as long as the page was
      // open (measured 2026-11-12 with Narrow on: 92 redraws in 6 seconds).
      var isCard = function(c){ return c.classList && c.classList.contains('product-card') && !c.classList.contains('trhp-tile'); };
      var cards = Array.prototype.filter.call(grid.children, isCard);
      var groups = new Map();
      cards.forEach(function(c, idx){
        if (c.dataset.trhDone) return;
        var tEl = c.querySelector('.product-title');
        var bEl = c.querySelector('.product-brand');
        var raw = tEl ? tEl.textContent.trim() : '';
        var vendor = bEl ? bEl.textContent.trim() : '';
        var link = c.matches('a') ? c : c.querySelector('a.product-card__main');
        var href = link ? link.getAttribute('href') : '';
        var tm = tagMap && tagMap[handleOf(href)];
        var key = tm ? 'cw|' + tm.key : 't|' + (vendor + '|' + cleanTitle(raw, vendor)).toLowerCase();
        var w;
        if (tm) w = tm.width;
        else {
          var wb = c.querySelector('.product-card__width-badge');
          w = wb ? (wb.classList.contains('product-card__width-badge--extra-wide') ? 'X-Wide' : wb.classList.contains('product-card__width-badge--narrow') ? 'Narrow' : 'Wide') : widthOf(raw);
        }
        if (!groups.has(key)) groups.set(key, []);
        groups.get(key).push({ card: c, link: link, href: href, width: w, raw: raw, vendor: vendor, idx: idx });
      });
      groups.forEach(function(members){
        members.sort(function(a, b){ return a.idx - b.idx; });
        var rep = members.filter(function(m){ return m.width === 'Standard'; })[0] || members[0];
        var title = cleanTitle(rep.raw, rep.vendor);
        var tEl = rep.card.querySelector('.product-title');
        if (members.length < 2) {
          if (tEl) tEl.textContent = title;
          rep.card.dataset.trhDone = '1';
          return;
        }
        var first = members[0].card;
        var card = rep.card;
        if (card.matches('a')) {
          var wrap = document.createElement('div');
          wrap.className = card.className + ' product-card--group';
          wrap.setAttribute('role', 'listitem');
          card.removeAttribute('role');
          card.className = 'product-card__main';
          card.parentNode.insertBefore(wrap, card);
          wrap.appendChild(card);
          card = wrap;
        }
        if (first !== rep.card && first !== card && first.parentNode) first.parentNode.insertBefore(card, first);
        if (tEl) tEl.textContent = title;
        var badge = card.querySelector('.product-card__width-badge'); if (badge) badge.remove();

        // colorways of the shown width become swatches
        var sw = [], seen = {};
        members.filter(function(m){ return m.width === rep.width; }).forEach(function(m){
          swatchesOf(m).forEach(function(s){ if (s.href && !seen[s.href]) { seen[s.href] = 1; sw.push(s); } });
        });
        var swRow = card.querySelector('.cw-swatches');
        if (sw.length > 1) {
          var repHref = rep.href, shown = sw.slice(0, 6), extra = sw.length - shown.length;
          var html = shown.map(function(s){
            return '<a href="' + s.href + '" class="cw-swatch' + (s.href === repHref ? ' cw-swatch--active' : '') + '" aria-label="' + String(s.label).replace(/"/g, '&quot;') + '" title="' + String(s.label).replace(/"/g, '&quot;') + '"><img src="' + s.img + '" alt="" loading="lazy"></a>';
          }).join('') + (extra > 0 ? '<span class="cw-swatch-more">+' + extra + '</span>' : '');
          if (!swRow) { swRow = document.createElement('div'); swRow.className = 'cw-swatches trh-swatches-added'; swRow.setAttribute('role', 'group'); swRow.setAttribute('aria-label', 'Available colors'); card.appendChild(swRow); }
          swRow.innerHTML = html;
        }

        // width links
        var byW = {};
        members.forEach(function(m){ if (!byW[m.width] && m.href) byW[m.width] = m.href; });
        var keys = Object.keys(byW);
        if (keys.length > 1) {
          var wh = '<span class="trh-widths__label">Widths</span>';
          keys.sort(function(a, b){ return WRANK[a] - WRANK[b]; }).forEach(function(w){
            wh += '<a href="' + byW[w] + '"' + (w === rep.width ? ' class="is-rep"' : '') + '>' + w + '</a>';
          });
          var row = document.createElement('div');
          row.className = 'trh-widths';
          row.innerHTML = wh;
          if (swRow) card.insertBefore(row, swRow); else card.appendChild(row);
        }
        members.forEach(function(m){ if (m.card !== rep.card && m.card !== card && m.card.parentNode) m.card.parentNode.removeChild(m.card); });
        card.dataset.trhDone = '1';
      });

      // sort
      var current = Array.prototype.filter.call(grid.children, isCard);
      var list = current.slice();
      list.forEach(function(c, i){ if (!c.dataset.trhOrder) c.dataset.trhOrder = i; });
      if (sortMode !== 'featured') {
        list.sort(function(a, b){ return sortMode === 'price-asc' ? priceOf(a) - priceOf(b) : priceOf(b) - priceOf(a); });
      } else {
        list.sort(function(a, b){ return a.dataset.trhOrder - b.dataset.trhOrder; });
      }
      // Re-append ONLY when the order actually changed. Appending every card
      // on every pass is a full redraw, and this runs every 250ms while the
      // page settles, which was the 4 to 5 flickers on every load.
      var sameOrder = list.every(function(c, i){ return c === current[i]; });
      if (!sameOrder) list.forEach(function(c){ grid.appendChild(c); });

      // The help box: leave it alone when it is already where it belongs.
      // Removing and re-inserting it every pass was another redraw, and threw
      // away the House Call line added inside it, which then got re-added.
      var old = grid.querySelector('.trh-help');
      var tpl = document.getElementById('trh-help-tpl');
      if (tpl && list.length > 8) {
        if (!old || old.nextElementSibling !== list[6]) grid.insertBefore(old || tpl.content.firstElementChild.cloneNode(true), list[6]);
      } else if (old) {
        old.remove();
      }

      var count = document.getElementById('resultsCount');
      if (count && list.length) count.innerHTML = '<strong>' + list.length + '</strong> ' + (list.length === 1 ? 'style' : 'styles');
      addSort();
    } catch (e) { if (window.console) console.warn('trh enhance', e); }
    if (obs) obs.observe(grid, { childList: true });
  }

  function addSort(){
    if (document.getElementById('trhSort')) return;
    var count = document.getElementById('resultsCount');
    if (!count) return;
    var box = document.createElement('label');
    box.className = 'trh-sort';
    box.innerHTML = 'Sort <select id="trhSort"><option value="featured">Featured</option><option value="price-asc">Price: low to high</option><option value="price-desc">Price: high to low</option></select>';
    count.parentNode.insertBefore(box, count.nextSibling);
    box.querySelector('select').addEventListener('change', function(e){ sortMode = e.target.value; enhance(); });
  }

  obs = new MutationObserver(function(){ setTimeout(enhance, 0); });
  obs.observe(grid, { childList: true });
  window.addEventListener('productsLoaded', function(){ setTimeout(function(){ tagMap = null; reorderFilters(); buildChips(); syncChips(); }, 50); });
  var tries = 0;
  (function wait(){
    reorderFilters(); buildChips(); syncChips();
    if (grid.querySelector('.product-card')) enhance();
    if (++tries < 60 && !(document.getElementById('trhSort') && chipsBox && chipsBox.dataset.built)) setTimeout(wait, 250);
  })();
})();
</script>
{%- endif -%}
