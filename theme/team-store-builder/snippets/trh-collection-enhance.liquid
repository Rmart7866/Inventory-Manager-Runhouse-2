        <div class="trh-sf__opts" data-q="events">
          <button type="button" data-v="sprint">55m to 200m</button>
          <button type="button" data-v="400">400m</button>
          <button type="button" data-v="hurdles">Hurdles</button>
          <button type="button" data-v="md">800m / mile</button>
          <button type="button" data-v="dist">3200m, 5K, 10K, steeple</button>
          <button type="button" data-v="xc">Cross country</button>
          <button type="button" data-v="hj">High jump</button>
          <button type="button" data-v="lj">Long jump</button>
          <button type="button" data-v="tj">Triple jump</button>
          <button type="button" data-v="pv">Pole vault</button>
          <button type="button" data-v="throws">Shot, discus, hammer</button>
          <button type="button" data-v="jav">Javelin</button>
        </div>
      </div>
      <div class="trh-sf__step">
        <p class="trh-sf__q"><span class="trh-sf__n">2</span><span>Your level</span></p>
        <div class="trh-sf__opts" data-q="level" data-single="1">
          <button type="button" data-v="new">First pair / middle school</button>
          <button type="button" data-v="hs" class="is-on" aria-pressed="true">High school regular</button>
          <button type="button" data-v="elite">Championship racer</button>
        </div>
      </div>
      <div class="trh-sf__step">
        <p class="trh-sf__q"><span class="trh-sf__n">3</span><span>Your budget</span></p>
        <div class="trh-sf__opts" data-q="budget" data-single="1">
          <button type="button" data-v="90">Under $90</button>
          <button type="button" data-v="130">Up to $130</button>
          <button type="button" data-v="0" class="is-on" aria-pressed="true">Show me everything</button>
        </div>
      </div>
    </div>
    <div class="trh-sf__go"><button type="button" class="trh-sf__btn" disabled>Find my spikes</button><span class="trh-sf__err">Pick at least one event to get started.</span></div>
    <div class="trh-sf__out" aria-live="polite"></div>
  </section>
  <style>
    .trh-sf{--sf-navy:#1e3a8a;--sf-orange:#f97316;--sf-ink:#111827;--sf-mute:#6b7280;--sf-line:#e5e7eb;--sf-soft:#f3f4f6;background:#fff;border:1px solid var(--sf-line);border-radius:16px;box-shadow:0 1px 3px rgba(17,24,39,.06);padding:28px 32px;margin:8px 0 32px;color:var(--sf-ink)}
    .trh-sf__head{margin:0 0 22px}
    .trh-sf__eyebrow{margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sf-orange)}
    .trh-sf__title{margin:0 0 6px;font-size:24px;line-height:1.2;font-weight:800;letter-spacing:-.01em;text-transform:none;color:var(--sf-ink)}
    .trh-sf__lede{margin:0;font-size:15px;color:var(--sf-mute)}
    .trh-sf__steps{border-top:1px solid var(--sf-line)}
    .trh-sf__step{display:grid;grid-template-columns:200px 1fr;gap:16px;align-items:start;padding:16px 0;border-bottom:1px solid var(--sf-line)}
    .trh-sf__q{display:flex;gap:10px;align-items:flex-start;margin:0;padding-top:7px;font-size:15px;font-weight:700;line-height:1.3}
    .trh-sf__q small{display:block;font-size:12.5px;font-weight:400;color:var(--sf-mute);margin-top:2px}
    .trh-sf__n{flex:none;display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:50%;background:var(--sf-navy);color:#fff;font-size:12px;font-weight:700}
    .trh-sf__opts{display:flex;flex-wrap:wrap;gap:8px}
    .trh-sf__opts button{appearance:none;border:1px solid transparent;background:var(--sf-soft);border-radius:999px;padding:8px 15px;font:inherit;font-size:14px;line-height:1.2;color:var(--sf-ink);cursor:pointer;transition:background .15s,color .15s,border-color .15s}
    .trh-sf__opts button:hover{border-color:#c7d2fe;background:#eef2ff}
    .trh-sf__opts button.is-on{background:var(--sf-navy);border-color:var(--sf-navy);color:#fff}
    .trh-sf__opts button:focus-visible,.trh-sf__btn:focus-visible{outline:2px solid var(--sf-orange);outline-offset:2px}
    .trh-sf__go{display:flex;align-items:center;gap:14px;padding-top:20px}
    .trh-sf__btn{appearance:none;background:var(--sf-orange);color:#fff;border:0;border-radius:10px;padding:13px 26px;font:inherit;font-weight:800;font-size:15px;cursor:pointer;transition:filter .15s}
    .trh-sf__btn:hover{filter:brightness(.95)}
    .trh-sf__btn:disabled{background:#fdba74;cursor:not-allowed}
    .trh-sf__err{font-size:13.5px;color:var(--sf-mute)}
    .trh-sf__btn:not(:disabled)+.trh-sf__err{display:none}
    .trh-sf__out{scroll-margin-top:110px}
    .trh-sf__out:not(:empty){margin-top:28px;padding-top:24px;border-top:1px solid var(--sf-line)}
    .trh-sf__loading{margin:0;color:var(--sf-mute);font-size:14px}
    .trh-sf__fit{margin:0 0 28px;padding:2px 0 2px 14px;border-left:3px solid var(--sf-orange);font-size:14.5px;line-height:1.5}
    .trh-sf__fit a,.trh-sf__note a{color:var(--sf-navy);font-weight:600;text-decoration:underline;text-underline-offset:2px}
    .trh-sf__group+.trh-sf__group{margin-top:36px}
    .trh-sf__gh{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin:0 0 4px}
    .trh-sf__gt{margin:0;font-size:19px;font-weight:800;text-transform:none;letter-spacing:-.01em;color:var(--sf-ink)}
    .trh-sf__all{flex:none;font-size:14px;font-weight:700;color:var(--sf-navy);text-decoration:none;white-space:nowrap}
    .trh-sf__all:hover{text-decoration:underline}
    .trh-sf__why{margin:0 0 6px;font-size:14px;color:var(--sf-mute);line-height:1.5}
    .trh-sf__note{margin:8px 0 0;padding-left:12px;border-left:3px solid var(--sf-navy);font-size:14px;line-height:1.5;color:var(--sf-ink)}
    .trh-sf__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px;margin-top:16px}
    .trh-sf__card{display:flex;flex-direction:column;text-decoration:none;color:var(--sf-ink)}
    .trh-sf__img{display:block;aspect-ratio:4/3;background:#fff;border:1px solid #eef0f3;border-radius:12px;overflow:hidden;margin-bottom:10px;transition:border-color .15s,box-shadow .15s}
    .trh-sf__img img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .2s}
    .trh-sf__card:hover .trh-sf__img{border-color:#c7d2fe;box-shadow:0 4px 14px rgba(30,58,138,.08)}
    .trh-sf__card:hover .trh-sf__img img{transform:scale(1.03)}
    .trh-sf__v{font-size:11.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--sf-mute)}
    .trh-sf__name{margin:2px 0 4px;font-size:14.5px;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .trh-sf__card:hover .trh-sf__name{text-decoration:underline;text-underline-offset:2px}
    .trh-sf__meta{font-size:14px;font-weight:700}
    .trh-sf__meta span{font-weight:400;color:var(--sf-mute)}
    @media (max-width:989px){.trh-sf__grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
    @media (max-width:749px){.trh-sf{padding:22px 18px;border-radius:12px}.trh-sf__title{font-size:21px}.trh-sf__step{grid-template-columns:1fr;gap:10px}.trh-sf__q{padding-top:0}.trh-sf__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.trh-sf__go{flex-direction:column;align-items:stretch;text-align:center}}
  </style>
  {% raw %}
  <script>
  (function(){
    var root=document.getElementById('spike-finder'); if(!root||root.dataset.ready) return; root.dataset.ready='1';
    var state={events:[],level:'hs',budget:0};
    var btn=root.querySelector('.trh-sf__btn'), out=root.querySelector('.trh-sf__out');
    root.querySelectorAll('.trh-sf__opts').forEach(function(g){
      var q=g.dataset.q, single=!!g.dataset.single;
      g.addEventListener('click',function(e){
        var b=e.target.closest('button'); if(!b) return; var v=b.dataset.v;
        if(single){ g.querySelectorAll('button').forEach(function(x){x.classList.remove('is-on');x.setAttribute('aria-pressed','false');}); b.classList.add('is-on'); b.setAttribute('aria-pressed','true'); state[q]=(q==='budget')?parseInt(v,10):v; }
        else { var i=state.events.indexOf(v); if(i>-1){state.events.splice(i,1);b.classList.remove('is-on');b.setAttribute('aria-pressed','false');} else {state.events.push(v);b.classList.add('is-on');b.setAttribute('aria-pressed','true');} btn.disabled=!state.events.length; }
      });
    });
    var cache={};
    function load(h){ if(!cache[h]) cache[h]=fetch('/collections/'+h+'/products.json?limit=250').then(function(r){return r.json();}).then(function(j){return j.products||[];}).catch(function(){return [];}); return cache[h]; }
    var GROUPS={
      sprint:{t:'Sprint spikes',c:'sprint-spikes',why:'A stiff plate and aggressive pins keep you up on your toes from the blocks.'},
      mid:{t:'Mid-distance spikes',c:'mid-distance-spikes',why:'A firm plate for speed plus a cushioned heel.'},
      dist:{t:'Distance spikes',c:'distance-spikes',why:'Cushioned and flexible enough to stay comfortable for 8 to 25 laps.'},
      xc:{t:'Cross country spikes',c:'cross-country-spikes',why:'A rubber outsole that grips grass, dirt and mud, built to last a full 5K.'},
      hj:{t:'High jump spikes',c:'high-jump-spikes',tag:'high jump',why:'Heel pins and a stable upper for the curve and plant. Many are made for a left- or right-foot takeoff (L or R in the name), so check yours.'},
      lj:{t:'Long jump spikes',c:'long-jump-spikes',tag:'long jump',why:'A stiff, sprint-like plate for a fast approach and takeoff.'},
      tj:{t:'Triple jump spikes',c:'triple-jump-spikes',tag:'triple jump',why:'A cushioned heel for the hop and step landings.'},
      pv:{t:'Pole vault spikes',c:'pole-vault-spikes',tag:'pole vault',why:'Close to a sprint spike, with a bit more cushion for the runway and plant.'},
      throws:{t:'Throwing shoes',c:'throwing-shoes',not:/javelin/i,why:'A smooth, durable sole for spinning or gliding in the ring.'}
    };
    function has(ev,v){ return ev.indexOf(v)>-1; }
    function needs(ev){
      var n=[], add=function(k,extra){ var f=n.filter(function(x){return x.k===k;})[0]; if(f){ if(extra) f.extra+=(f.extra?' ':'')+extra; } else n.push({k:k,extra:extra||''}); };
      var sprinter=has(ev,'sprint')||has(ev,'400');
      if(sprinter&&!has(ev,'hurdles')) add('sprint', has(ev,'400')&&!has(ev,'sprint')?'Many 400m runners also like a mid-distance spike for the last 100m.':'');
      if(has(ev,'hurdles')) add('mid','Hurdlers land on their heels coming off every barrier, so we fit hurdlers in mid-distance spikes, not sprint spikes.');
      if(has(ev,'hurdles')&&sprinter) add('mid','The same pair works for your sprint races too, so one pair of mid-distance spikes covers it all.');
      if(has(ev,'md')) add('mid');
      if(has(ev,'dist')) add('dist');
      if(has(ev,'xc')) add('xc');
      if(has(ev,'hj')) add('hj');
      if(has(ev,'lj')) add('lj');
      if(has(ev,'tj')) add('tj','No triple jump-specific pair? Go with a <a href="/collections/mid-distance-spikes">mid-distance spike</a>, not a sprint or long jump spike, because you need the heel.');
      if(has(ev,'pv')) add('pv');
      if(has(ev,'throws')) add('throws');
      if(has(ev,'jav')) add('mid','Javelin throwers need heel pins to brace on the block, so we fit javelin in mid-distance spikes.');
      return n;
    }
    function price(p){ var a=p.variants.filter(function(v){return v.available;}); var v=(a.length?a:p.variants).map(function(v){return parseFloat(v.price);}); return Math.min.apply(null,v); }
    function base(t){ return t.replace(/\s*[-–]\s+.*$/,'').replace(/\s*\(.*$/,'').replace(/\b(mens|men's|womens|women's|unisex)\b/ig,'').replace(/\s+/g,'').toLowerCase(); }
    function pick(list,g){
      list=list.filter(function(p){ return p.variants.some(function(v){return v.available;}); });
      if(g.tag) list=list.filter(function(p){ return (p.tags||[]).some(function(t){return t.toLowerCase()===g.tag;}); });
      if(g.not) list=list.filter(function(p){ return !g.not.test(p.title); });
      var seen={}, models=[];
      list.forEach(function(p){ var k=base(p.title); if(seen[k]){seen[k].n++;return;} seen[k]={p:p,n:1,price:price(p)}; models.push(seen[k]); });
      var cap=state.budget, inBudget=cap?models.filter(function(m){return m.price<cap;}):models, over=false;
      if(cap&&!inBudget.length&&models.length){ inBudget=models.slice(); over=true; }
      inBudget.sort(function(a,b){ return state.level==='elite'?b.price-a.price:a.price-b.price; });
      if(state.level==='hs') inBudget.sort(function(a,b){ return Math.abs(a.price-110)-Math.abs(b.price-110); });
      return {items:inBudget.slice(0,4),over:over};
    }
    function money(n){ return '$'+(n%1?n.toFixed(2):n.toFixed(0)); }
    function cleanName(p){
      var name=p.title.replace(/\s*\(.*?\)\s*$/,'');
      if(/-\s*[^-]*\/[^-]*$/.test(name)) name=name.replace(/\s*-\s*[^-]*$/,'');
      var v=(p.vendor||'').trim();
      if(v&&name.toLowerCase().indexOf(v.toLowerCase()+' ')===0) name=name.slice(v.length+1);
      name=name.replace(/(\S)-\s+[^-]*$/,'$1').replace(/^unisex\s+/i,'');
      return name.replace(/\s+-\s*$/,'').trim();
    }
    function card(m){
      var p=m.p, img=p.images&&p.images[0]?p.images[0].src.replace(/(\.[a-z]+)(\?|$)/i,'_500x$1$2'):'';
      return '<a class="trh-sf__card" href="/products/'+p.handle+'"><span class="trh-sf__img">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</span><span class="trh-sf__v">'+(p.vendor||'')+'</span><span class="trh-sf__name">'+cleanName(p)+'</span><span class="trh-sf__meta">'+money(m.price)+(m.n>1?' <span>· '+m.n+' colors</span>':'')+'</span></a>';
    }
    btn.addEventListener('click',function(){
      if(!state.events.length) return;
      var n=needs(state.events); out.innerHTML='<p class="trh-sf__loading">Finding your spikes…</p>';
      Promise.all(n.map(function(x){return load(GROUPS[x.k].c);})).then(function(lists){
        var html='';
        if(n.length>2){ html+='<p class="trh-sf__fit"><strong>Want one pair for everything?</strong> A <a href="/collections/mid-distance-spikes">mid-distance spike</a> is the most versatile spike we sell. Or stop into Walpole, Needham or Falmouth and we\'ll fit you for your main event.</p>'; }
        n.forEach(function(x,i){
          var g=GROUPS[x.k], r=pick(lists[i],g);
          html+='<div class="trh-sf__group"><div class="trh-sf__gh"><h3 class="trh-sf__gt">'+g.t+'</h3><a class="trh-sf__all" href="/collections/'+g.c+'">Shop all →</a></div><p class="trh-sf__why">'+g.why+'</p>';
          if(x.extra) html+='<p class="trh-sf__note">'+x.extra+'</p>';
          if(r.over) html+='<p class="trh-sf__note">Nothing in stock under your budget right now. Here are the closest options.</p>';
          if(!r.items.length){ html+='<p class="trh-sf__note">We don\'t have these online right now. Call or stop into any of our stores and we\'ll find you a pair.</p>'; }
          else html+='<div class="trh-sf__grid">'+r.items.map(card).join('')+'</div>';
          html+='</div>';
        });
        out.innerHTML=html;
        out.scrollIntoView({behavior:'smooth',block:'start'});
      });
    });
  })();
  </script>
  {% endraw %}
