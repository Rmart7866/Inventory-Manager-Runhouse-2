  <!-- Critical CSS with simplified selector handling -->
  <style>
    /* Add padding to section header to prevent overlap with the fixed header */
.section-header,
h1.section-header__title {
  padding-top: 20px; /* Adjust this value as needed */
  margin-top: 10px; /* Add some margin too for spacing */
}
/* If the header is specifically overlapping just at the top */
.section-header {
  position: relative; /* Ensure positioning context */
  z-index: 1; /* Lower than header z-index to prevent overlap issues */
}
    
    /* Impulse draws its own page loading indicator with theme.css:
         .loading:after/.before { width:100px; height:3px; top:50%; left:50%;
         background: var(--colorBody) } which is a short black bar in the dead
         centre of the viewport. <html> carries .loading on every page load, and
         .unload on every navigation away, so it appeared everywhere. It was
         invisible only because html.loading used to hide the whole document.
         Now that the page paints immediately, the bar paints too. */
    html.loading::before, html.loading::after,
    html.unload::before, html.unload::after {
      content: none;
    }

    /* iOS Safari zooms the entire page when a form control whose font-size is
       under 16px takes focus, and it does not zoom back out. Tapping the search
       box or the newsletter field on a phone therefore leaves the shopper
       looking at a magnified, horizontally scrolled page. 16px is the exact
       threshold. !important is deliberate: these controls are styled from
       section <style> blocks further down the document (.search-input at 14px,
       the footer newsletter at 15.2px, the locale picker at 13.6px), so source
       order alone would not win. Phones only, desktop keeps its type scale. */
    @media (max-width: 749px) {
      input:not([type=checkbox]):not([type=radio]):not([type=range]),
      select,
      textarea {
        font-size: 16px !important;
      }
    }

    /* Prevent FOUC (Flash of Unstyled Content).
       Scoped to the variant selectors that actually flicker. This used to hide
       <html> itself, which left the whole page blank until DOMContentLoaded
       plus a 300ms timer, on every page load. */
    html.loading .product-single__variants,
    html.loading [data-product-select] {
      visibility: hidden;
    }
/* REMOVE SELECTION DISPLAY CAUSE VO PRODUCT */
    .product-single__variants.no-js {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  overflow: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
    .snize-sticky-searchbox,
.snize-custom-widget-opener {
  display: none !important;
}
    
    /* Modified approach for selectors - less aggressive hiding */
    .product-form.loading .product-form__controls-group {
      min-height: 50px;
      position: relative;
    }
    
    /* Create a less aggressive hiding approach for variant selectors */
    .product-single__variants,
    [data-product-select] {
      /* These are hidden but will be revealed by JS */
      opacity: 0.1;
      height: auto !important;
      overflow: visible !important;
      pointer-events: auto !important;
      transition: opacity 0.5s ease;
    }
    
    /* Subtle styling for sold-out variants */
    .bcpo-disabled, 
    .gsw-prg-item-sold-out .swatch-anchor {
      opacity: 0.4;
      filter: grayscale(80%);
      position: relative;
    }
    
    /* Add subtle overlay to sold-out items */
    .gsw-prg-item-sold-out .swatch-anchor::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(255, 255, 255, 0.3);
      z-index: 2;
    }
    
    /* Add subtle diagonal line */
    .gsw-prg-item-sold-out .swatch-anchor::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: linear-gradient(to top right, 
                               transparent 48%, 
                               rgba(200, 200, 200, 0.4) 49%,
                               rgba(200, 200, 200, 0.4) 51%, 
                               transparent 52%);
      z-index: 3;
    }
    
    /* Same styling for button-based variants */
    .bcpo-front-button-label.bcpo-disabled {
      opacity: 0.6;
      position: relative;
    }
    
    .bcpo-front-button-label.bcpo-disabled::after {
      content: "";
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      background: linear-gradient(to top right, 
                               transparent 48%, 
                               rgba(150, 150, 150, 0.5) 49%,
                               rgba(150, 150, 150, 0.5) 51%, 
                               transparent 52%);
      pointer-events: none;
    }
  </style>
