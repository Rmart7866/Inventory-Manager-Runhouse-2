  <script>
    // Simplified Variant Selector Handler with Fix for Flickering
    document.addEventListener('DOMContentLoaded', function() {
      // Show page content immediately
      setTimeout(function() {
        document.documentElement.classList.remove('loading');
      }, 300);
      
      // Simple function to show all variant selectors
      function showAllSelectors() {
        // Remove any hiding styles that might be causing flickering
        const selectors = document.querySelectorAll('.product-single__variants, [data-product-select], select[data-index], .single-option-selector');
        selectors.forEach(function(selector) {
          selector.style.opacity = '1';
          selector.style.display = 'block';
          selector.style.visibility = 'visible';
          selector.style.height = 'auto';
          selector.style.overflow = 'visible';
          selector.style.pointerEvents = 'auto';
        });
        
        // Ensure product forms are not in a loading state
        document.querySelectorAll('.product-form').forEach(function(form) {
          form.classList.remove('loading');
        });
      }
      
      
      // Special handling for Runkeeper pages
      if (window.location.pathname.includes('/collections/asics-runkeeper')) {
        window.addEventListener('load', function() {
          const klaviyoSelectors = [
            '.needsclick.klaviyo-form',
            '[data-testid^="klaviyo-form"]',
            'style[data-klaviyo]',
            '#klaviyo-bis-iframe',
            '[class*="kl-private-"]'
          ];
          
          klaviyoSelectors.forEach(selector => {
            document.querySelectorAll(selector).forEach(el => el.remove());
          });
        });
      }
      
      // Call immediately to start showing selectors
      showAllSelectors();
      
      // Call again after a delay to ensure they're shown
      setTimeout(showAllSelectors, 500);
      
      // And one final time after page is fully loaded
      window.addEventListener('load', function() {
        showAllSelectors();
        
        // Make native selectors visible as a fallback
        setTimeout(function() {
          const style = document.createElement('style');
          style.innerHTML = `
            .product-single__variants,
            [data-product-select],
            select[data-index="option1"],
            select[data-index="option2"],
            select[data-index="option3"],
            .single-option-selector:not([id^="bcpo-select-option"]),
            .selector-wrapper:not(.bcpo-buttons) {
              display: block !important;
              visibility: visible !important;
              opacity: 1 !important;
              height: auto !important;
              overflow: visible !important;
              pointer-events: auto !important;
            }
            
            .bcpo, .gsw-list-product-groups {
              opacity: 1 !important;
              visibility: visible !important;
            }
          `;
          document.head.appendChild(style);
        }, 1000);
      });
      
      // Save session storage for navigation
      const currentPath = window.location.pathname;
      if (!currentPath.includes('/cart') && 
          (currentPath.includes('/collections/') || currentPath.includes('/products/'))) {
        sessionStorage.setItem('previousPageUrl', window.location.href);
      }
    });
// Add this to your theme.liquid file in the script section
document.addEventListener('DOMContentLoaded', function() {
  // Cache to store product variant data to avoid repeated API calls
  const productVariantsCache = {};
  
  function enhanceProductCards() {
    // Look for products with variants and add the indicator
    document.querySelectorAll('.spf-product-card__inner').forEach(card => {
      const productHandle = getProductHandleFromCard(card);
      if (!productHandle) return;
      
      // First check if we already have color variants data in the DOM
      const existingVariantsData = getExistingVariantsData(card);
      if (existingVariantsData && existingVariantsData.length > 1) {
        processVariantData(card, productHandle, existingVariantsData);
        return;
      }
      
      // If no existing data, fetch it from the API
      if (productVariantsCache[productHandle]) {
        // Use cached data if available
        processVariantData(card, productHandle, productVariantsCache[productHandle]);
      } else {
        // Otherwise fetch from the API
        fetchProductVariants(productHandle).then(variants => {
          productVariantsCache[productHandle] = variants;
          processVariantData(card, productHandle, variants);
        });
      }
    });
  }
  
  function processVariantData(card, productHandle, variants) {
    if (variants && variants.length > 1) {
      // Add class to the card to indicate it has multiple colors
      card.classList.add('has-multiple-colors');
      
      // Add "more colors available" text
      addVariantCountText(card, variants.length);
      
      // Add color swatch preview
      addColorSwatchPreview(card, variants);
      
      // Add "See all colors" button that links to product page
      addSeeAllColorsButton(card, productHandle);
    }
  }
  
  // Try to get existing variants data from the DOM first
  function getExistingVariantsData(card) {
    // Try GLO Swatch data attribute
    const swatchContainer = card.querySelector('[data-gsw-variants]');
    if (swatchContainer) {
      try {
        const variantsData = JSON.parse(swatchContainer.getAttribute('data-gsw-variants'));
        if (Array.isArray(variantsData) && variantsData.length) {
          return variantsData;
        }
      } catch (e) {
        console.log('Error parsing swatch variants data', e);
      }
    }
    
    // Try Globo image data attribute
    const imageElement = card.querySelector('.spf-product-card__image');
    if (imageElement && imageElement.dataset.variants) {
      const variants = imageElement.dataset.variants.split(',').filter(v => v.trim());
      if (variants.length) {
        return variants;
      }
    }
    
    return null;
  }
  
  // Extract product handle from card (adjust selectors as needed)
  function getProductHandleFromCard(card) {
    // Try multiple selectors to find the product handle
    const link = card.querySelector('a[href*="/products/"]');
    if (!link) return null;
    
    const href = link.getAttribute('href');
    const match = href.match(/\/products\/([a-z0-9-]+)/);
    return match ? match[1] : null;
  }
  
  // Fetch product variants data
  function fetchProductVariants(handle) {
    return fetch(`/products/${handle}.js`)
      .then(response => response.json())
      .then(product => {
        // Extract color variants (adjust based on your option naming)
        const colorOption = product.options.find(option => 
          option.name.toLowerCase().includes('color') || 
          option.name.toLowerCase().includes('colour')
        );
        
        if (colorOption) {
          const optionIndex = product.options.findIndex(option => 
            option.name.toLowerCase().includes('color') || 
            option.name.toLowerCase().includes('colour')
          );
          
          // Return unique color values with their hex codes if available
          return [...new Set(product.variants.map(v => {
            const optionValue = v[`option${optionIndex + 1}`];
            // Try to extract color info
            let colorInfo = { name: optionValue };
            
            // Look for color swatch in variant's image URL or featured_image
            if (v.featured_image && v.featured_image.src) {
              // In some cases, color may be represented in the image URL
              colorInfo.image = v.featured_image.src;
            }
            
            return colorInfo;
          }))];
        } else {
          // If no color option found, check if product has variants at all
          return product.variants.length > 1 ? 
            product.variants.map(v => ({ name: `Option ${v.title}` })) : 
            [];
        }
      })
      .catch(err => {
        console.error('Error fetching product data:', err);
        return [];
      });
  }
  
  // Add variant count text to product card
  function addVariantCountText(card, variantCount) {
    const infoSection = card.querySelector('.spf-product__info');
    if (!infoSection) return;
    
    // Remove any existing variant text to avoid duplicates
    const existing = infoSection.querySelectorAll('.color-variant-count');
    existing.forEach(el => el.remove());
    
    // Find price wrapper to insert after
    const priceWrapper = infoSection.querySelector('.spf-product-card__price-wrapper');
    if (!priceWrapper) return;
    
    // Create variant text element
    const variantText = document.createElement('div');
    variantText.className = 'color-variant-count';
    
    // Show number of colors available
    variantText.innerHTML = `Available in <span>${variantCount} colors</span>`;
    
    // Insert after price wrapper
    priceWrapper.insertAdjacentElement('afterend', variantText);
  }
  
  // Add a preview of color swatches
  function addColorSwatchPreview(card, variants) {
    // Only show up to 3 color previews
    const previewVariants = variants.slice(0, 3);
    
    const variantCount = card.querySelector('.color-variant-count');
    if (!variantCount) return;
    
    const previewContainer = document.createElement('div');
    previewContainer.className = 'color-variant-preview';
    
    // Add color dots
    previewVariants.forEach((variant, index) => {
      const colorDot = document.createElement('div');
      colorDot.className = 'color-preview-dot';
      
      // Try to use actual color information if available
      if (variant.hasOwnProperty('color_code')) {
        colorDot.style.backgroundColor = variant.color_code;
      } else {
        // Default colors if no color codes available
        const dummyColors = ['#FFA000', '#4682B4', '#228B22', '#8B4513', '#6A5ACD', '#FF6347'];
        colorDot.style.backgroundColor = dummyColors[index % dummyColors.length];
      }
      
      // Add title attribute for hover tooltip
      if (variant.name) {
        colorDot.title = variant.name;
      }
      
      previewContainer.appendChild(colorDot);
    });
    
    // Add more indicator if there are more variants
    if (variants.length > 3) {
      const moreDot = document.createElement('div');
      moreDot.className = 'color-preview-dot';
      moreDot.style.backgroundColor = '#ccc';
      moreDot.style.position = 'relative';
      
      // Add "+" symbol inside the dot
      moreDot.innerHTML = '<span style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 6px; line-height: 1; color: #fff;">+</span>';
      moreDot.title = `${variants.length - 3} more colors`;
      
      previewContainer.appendChild(moreDot);
    }
    
    variantCount.appendChild(previewContainer);
  }
  
  // Add a button to see all colors (linking to product page)
  function addSeeAllColorsButton(card, productHandle) {
    const infoSection = card.querySelector('.spf-product__info');
    if (!infoSection) return;
    
    // Remove any existing buttons to avoid duplicates
    const existing = infoSection.querySelectorAll('.more-colors-btn');
    existing.forEach(el => el.remove());
    
    const variantCount = infoSection.querySelector('.color-variant-count');
    
    const moreColorsBtn = document.createElement('a');
    moreColorsBtn.className = 'more-colors-btn';
    moreColorsBtn.href = `/products/${productHandle}`;
    moreColorsBtn.textContent = 'See all colors';
    
    // Insert after variant count or price wrapper
    if (variantCount) {
      variantCount.insertAdjacentElement('afterend', moreColorsBtn);
    } else {
      const priceWrapper = infoSection.querySelector('.spf-product-card__price-wrapper');
      if (priceWrapper) {
        priceWrapper.insertAdjacentElement('afterend', moreColorsBtn);
      }
    }
  }
  
  // Run initially
  enhanceProductCards();
  
  // Also run after a short delay to catch dynamically loaded content
  setTimeout(enhanceProductCards, 1000);
  
  // Monitor for dynamically added content 
  const observer = new MutationObserver(function(mutations) {
    let shouldRun = false;
    
    for (const mutation of mutations) {
      if (mutation.addedNodes.length) {
        // Check if any of added nodes are product cards or contain product cards
        for (let i = 0; i < mutation.addedNodes.length; i++) {
          const node = mutation.addedNodes[i];
          if (node.nodeType === 1) { // Element node
            if (node.classList && (
                node.classList.contains('spf-product-card') || 
                node.classList.contains('spf-product-card__inner') ||
                node.querySelector('.spf-product-card')
              )) {
              shouldRun = true;
              break;
            }
          }
        }
      }
      
      if (shouldRun) break;
    }
    
    if (shouldRun) {
      // Debounce the execution to avoid multiple rapid calls
      if (window.variantDisplayTimeout) {
        clearTimeout(window.variantDisplayTimeout);
      }
      window.variantDisplayTimeout = setTimeout(enhanceProductCards, 100);
    }
  });
  
  observer.observe(document.body, { 
    childList: true, 
    subtree: true 
  });
  
  // Handle pagination or infinite scroll
  document.addEventListener('spf:updated', enhanceProductCards);
  document.addEventListener('spf:renderend', enhanceProductCards);
  
// For Shopify's section:load event (theme refreshes)
document.addEventListener('shopify:section:load', enhanceProductCards);

// Clean product titles by removing parenthetical text
function cleanProductTitles() {
  document.querySelectorAll('.spf-product-card__title').forEach(titleElement => {
    if (titleElement) {
      const text = titleElement.textContent;
      // Remove parenthetical text EXCEPT those containing "wide" or "narrow"
      const cleanedText = text.replace(/\s*\((?![^)]*\b(?:wide|narrow)\b)[^)]*\)/gi, '');
      titleElement.textContent = cleanedText;
    }
  });
}
  
  // Add savings amount to price section
  function addSavingsAmount() {
    document.querySelectorAll('.spf-product-card__inner').forEach(card => {
      const priceWrapper = card.querySelector('.spf-product-card__price-wrapper');
      const oldPriceElement = card.querySelector('.spf-product-card__oldprice');
      const salePriceElement = card.querySelector('.spf-product-card__saleprice');
      
      if (priceWrapper && oldPriceElement && salePriceElement && !priceWrapper.querySelector('.savings-amount')) {
        // Try to extract prices
        const oldPriceText = oldPriceElement.textContent.trim();
        const salePriceText = salePriceElement.textContent.trim();
        
        // Basic check for currency symbols and numbers
        const oldPriceMatch = oldPriceText.match(/[\$€£]?\s?(\d+(\.\d+)?)/);
        const salePriceMatch = salePriceText.match(/[\$€£]?\s?(\d+(\.\d+)?)/);
        
        if (oldPriceMatch && salePriceMatch) {
          const oldPrice = parseFloat(oldPriceMatch[1]);
          const salePrice = parseFloat(salePriceMatch[1]);
          
          if (!isNaN(oldPrice) && !isNaN(salePrice) && oldPrice > salePrice) {
            const savings = oldPrice - salePrice;
            const savingsElement = document.createElement('span');
            savingsElement.className = 'savings-amount';
            
            // Format currency based on locale detected from price text
            let currency = '$';
            if (oldPriceText.includes('€')) currency = '€';
            else if (oldPriceText.includes('£')) currency = '£';
            
            savingsElement.textContent = `Save ${currency}${savings.toFixed(2)}`;
            priceWrapper.appendChild(savingsElement);
          }
        }
      }
    });
  }
  
  // Convert standard sale badges to percentage format
  function updateSaleBadges() {
    document.querySelectorAll('.spf-product__label').forEach(badge => {
      if (!badge.textContent.includes('%') && !badge.classList.contains('spf-product__label-soldout')) {
        const productCard = badge.closest('.spf-product-card__inner');
        const oldPrice = productCard?.querySelector('.spf-product-card__oldprice');
        const salePrice = productCard?.querySelector('.spf-product-card__saleprice');
        
        if (oldPrice && salePrice) {
          // Extract prices
          const oldPriceText = oldPrice.textContent.trim();
          const salePriceText = salePrice.textContent.trim();
          
          const oldPriceMatch = oldPriceText.match(/[\$€£]?\s?(\d+(\.\d+)?)/);
          const salePriceMatch = salePriceText.match(/[\$€£]?\s?(\d+(\.\d+)?)/);
          
          if (oldPriceMatch && salePriceMatch) {
            const oldPriceValue = parseFloat(oldPriceMatch[1]);
            const salePriceValue = parseFloat(salePriceMatch[1]);
            
            if (oldPriceValue && salePriceValue) {
              const savingsPercent = Math.round((oldPriceValue - salePriceValue) / oldPriceValue * 100);
              badge.textContent = `${savingsPercent}%`;
            }
          }
        }
      }
    });
  }
  
  // Run all the enhancement functions
  function setupAllProductCardFeatures() {
    enhanceProductCards();
    cleanProductTitles();
    addSavingsAmount();
    updateSaleBadges();
  }
  
  // Run initially
  setupAllProductCardFeatures();
  
  // Run after a delay to catch any lazy-loaded content
  setTimeout(setupAllProductCardFeatures, 1000);
});
  </script>
  {%- comment -%} Asks before checkout when the cart holds the smallest size, which the product page pre-selects. See the snippet. {%- endcomment -%}
  {%- comment -%}
    REMEMBER WHERE THEY WERE, for the cart page's back link.

    Adding to cart now lands the shopper on the cart, so the way back has to
    name a real place. The first version recorded that place only at the moment
    of an add, which went stale immediately: remove the item, browse somewhere
    else, and the cart still offered "Back to Boyden Elementary Pom Pom",
    because nothing had added anything since. Clicking the cart icon straight
    from a collection had the same problem, offering the last thing added
    rather than the collection on screen.

    So record on EVERY page instead of at the moment of an add. Two keys:
      rhLastBrowse  a collection or search page, the best answer, and the one
                    the shopper most likely means by "back"
      rhLastPage    any non cart page, the fallback when this trip has not
                    been through a collection
    Both are sessionStorage, so they belong to one shopping trip.
  {%- endcomment -%}
  {%- unless template.name == 'cart' -%}
    {%- liquid
      assign back_label = ''
      assign back_kind = 'page'
      if template.name == 'collection' and collection.title != blank
        assign back_label = collection.title
        assign back_kind = 'browse'
      elsif template.name == 'search'
        assign back_label = 'search results'
        assign back_kind = 'browse'
      elsif template.name == 'product' and product.title != blank
        assign back_label = product.title
      elsif page_title != blank
        assign back_label = page_title
      endif
    -%}
    {%- if back_label != blank -%}
      <script>
        try {
          var rhHere = {
            url: window.location.pathname + window.location.search,
            label: {{ back_label | json }}
          };
          if ({{ back_kind | json }} === 'browse') {
            sessionStorage.setItem('rhLastBrowse', JSON.stringify(rhHere));
          }
          sessionStorage.setItem('rhLastPage', JSON.stringify(rhHere));
        } catch (e) { /* private mode, the history fallback still works */ }
      </script>
    {%- endif -%}
  {%- endunless -%}
  {%- render 'smallest-size-guard' -%}

  {%- comment -%} Plays slide videos only while they are on screen, see the file for why. {%- endcomment -%}
  <script src="{{ 'lazy-video.js' | asset_url }}" defer></script>
  {%- render 'trh-menu-icons' -%}
  {%- if template.name == 'collection' -%}{%- render 'trh-collection-header' -%}{%- endif -%}
</body>
