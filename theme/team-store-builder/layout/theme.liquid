  {%- if settings.disable_animations -%}
    <style>
      /* The theme gates only 4 of its 74 [data-aos] rules behind the disable switch.
         These are the rest that hold content back: image fades and the staggered
         grid delays that make a row of products appear one at a time. */
      [data-disable-animations="true"] .image-element,
      [data-disable-animations="true"] [data-aos] .image-element { opacity: 1; animation: none; }
      [data-disable-animations="true"] [data-aos^="row-of-"] .image-wrap img { animation-delay: 0s; }
    </style>
  {%- endif -%}

