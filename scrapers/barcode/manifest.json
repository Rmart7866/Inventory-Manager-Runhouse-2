{
  "manifest_version": 3,
  "name": "Barcode Lookup",
  "version": "1.0.0",
  "description": "Quick barcode lookup for products",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://therunhouse.com/*",
    "https://admin.shopify.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://therunhouse.com/products/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["barcode-database.json", "JsBarcode.all.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}