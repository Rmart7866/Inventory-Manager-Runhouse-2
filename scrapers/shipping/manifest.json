{
  "manifest_version": 3,
  "name": "B2B Shipping Form Filler",
  "version": "1.0",
  "description": "Auto-fill B2B shipping forms from Shopify order data",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://admin.shopify.com/store/*/orders/*",
        "*://admin.shopify.com/store/*/customers/*"
      ],
      "js": ["shopify-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://backstage.on-running.com/*",
        "*://b2b.on-running.com/*", 
        "*://on-running.com/b2b/*",
        "*://www.on-running.com/b2b/*",
        "*://portal.on-running.com/*",
        "*://dealer.on-running.com/*",
        "*://wholesale.on-running.com/*",
        "*://on-running.com/*",
        "*://www.on-running.com/*",
        "*://*.asics.com/*",
        "*://*.asicstiger.com/*",
        "*://*.brooks.com/*",
        "*://*.brooksrunning.com/*",
        "*://hokaus.deckersb2b.deckers.com/*",
        "*://*.deckersb2b.deckers.com/*",
        "*://pumab2b.com/*",
        "*://*.pumab2b.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "B2B Shipping Form Filler"
  }
}