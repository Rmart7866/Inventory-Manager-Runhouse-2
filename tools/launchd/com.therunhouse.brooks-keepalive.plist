<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Brooks FastTrack keep-alive, every hour at :45 (ASICS uses :30, the Brooks
  sweeps run on the hour). One page visit keeps the profile's login fresh;
  logs in nothing, notifies when the login is already gone.
  Install:
    cp tools/launchd/com.therunhouse.brooks-keepalive.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.therunhouse.brooks-keepalive.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.therunhouse.brooks-keepalive.plist
    rm ~/Library/LaunchAgents/com.therunhouse.brooks-keepalive.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.therunhouse.brooks-keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ryanmartin/.nvm/versions/node/v22.20.0/bin/node</string>
    <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2/tools/brooks-headless-run.mjs</string>
    <string>--keepalive</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>45</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-brooks-keepalive.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-brooks-keepalive.log</string>
</dict>
</plist>
