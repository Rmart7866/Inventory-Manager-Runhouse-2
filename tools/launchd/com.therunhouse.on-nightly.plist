<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ON stock, shoes and apparel, every morning at 5:50, so the day starts on
  fresh numbers. About seven ON API requests, ten seconds; it
  saves on-running-inventory-<n>.csv plus its images file to ~/Downloads, a verdict in
  the log and writes nothing to Shopify.
  Install:
    cp tools/launchd/com.therunhouse.on-nightly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.therunhouse.on-nightly.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.therunhouse.on-nightly.plist
    rm ~/Library/LaunchAgents/com.therunhouse.on-nightly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.therunhouse.on-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ryanmartin/.nvm/versions/node/v22.20.0/bin/node</string>
    <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2/tools/on-headless-run.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>50</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-on-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-on-nightly.log</string>
</dict>
</plist>
