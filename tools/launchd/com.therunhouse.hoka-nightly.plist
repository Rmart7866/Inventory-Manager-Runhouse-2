<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  HOKA ATS report, every morning at 4:30: ask, wait for the emailed link
  (up to 45 min, usually 1 to 10), download. Needs the needham@ Apps Script; it
  saves <Season>..._ATS_Report nightly-<stamp>.xlsx to ~/Downloads, a verdict in
  the log and writes nothing to Shopify.
  Install:
    cp tools/launchd/com.therunhouse.hoka-nightly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.therunhouse.hoka-nightly.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/com.therunhouse.hoka-nightly.plist
    rm ~/Library/LaunchAgents/com.therunhouse.hoka-nightly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.therunhouse.hoka-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/ryanmartin/.nvm/versions/node/v22.20.0/bin/node</string>
    <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2/tools/hoka-headless-run.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanmartin/Inventory-Manager-Runhouse-2</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-hoka-nightly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanmartin/Library/Logs/runhouse-hoka-nightly.log</string>
</dict>
</plist>
